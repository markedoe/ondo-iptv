        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Ondo están desactivadas: permítelas en Ajustes para recibir recordatorios."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do Ondo estão desativadas: permita-as em Ajustes para receber lembretes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondo 的通知已关闭：请在“设置”中允许通知以接收提醒。"
