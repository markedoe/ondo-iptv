    "Locked categories are hidden from home, search and My List, and ask for the PIN when opened.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories verrouillées sont masquées de l'accueil, de la recherche et de Ma liste, et demandent le code PIN à l'ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías bloqueadas no aparecen en Inicio, la búsqueda ni Mi lista, y piden el PIN al abrirlas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorias bloqueadas ficam ocultas no Início, na busca e na Minha lista, e pedem o PIN ao serem abertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定的分类不会显示在首页、搜索和我的片单中，打开时需要输入 PIN。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخفى الفئات المقفلة من الرئيسية والبحث وقائمتي، ويُطلب رمز PIN عند فتحها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक की गई श्रेणियाँ होम, खोज और मेरी सूची में नहीं दिखतीं, और खोलने पर PIN माँगती हैं।"
          }
        }
      }
    },
    "Long-press a channel and choose Hide Channel to remove it from lists, search and the guide.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une chaîne et choisissez Masquer la chaîne pour la retirer des listes, de la recherche et du guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un canal y elige Ocultar canal para quitarlo de las listas, la búsqueda y la guía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um canal e escolha Ocultar canal para removê-lo das listas, da busca e do guia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按频道并选择“隐藏频道”，即可将其从频道列表、搜索和节目指南中移除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على قناة واختر «إخفاء القناة» لإزالتها من القوائم والبحث ودليل البرامج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को सूचियों, खोज और गाइड से हटाने के लिए उसे देर तक दबाएँ और चैनल छिपाएँ चुनें।"
          }
        }
      }
    },
    "Long-press a channel and choose “Add to My List”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une chaîne et choisissez « Ajouter à Ma liste »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un canal y elige «Añadir a Mi lista»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um canal e escolha “Adicionar à Minha lista”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按频道，然后选择“添加到我的片单”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على قناة واختر «إضافة إلى قائمتي»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को देर तक दबाएँ और “मेरी सूची में जोड़ें” चुनें।"
          }
        }
      }
    },
    "Long-press a channel and choose “Add to My List”; it will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une chaîne et choisissez « Ajouter à Ma liste » ; elle apparaîtra ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un canal y elige «Añadir a Mi lista»; aparecerá aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um canal e escolha “Adicionar à Minha lista”; ele aparecerá aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按频道并选择“添加到我的片单”，之后它会显示在这里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على قناة واختر «إضافة إلى قائمتي»، وستظهر هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को देर तक दबाएँ और “मेरी सूची में जोड़ें” चुनें; वह यहाँ दिखेगा।"
          }
        }
      }
    },
