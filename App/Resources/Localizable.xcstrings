    "Only the pages you have opened are searched. Add a TMDb key in Settings to find all their movies and series.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les fiches déjà ouvertes sont parcourues. Ajoutez une clé TMDb dans les Réglages pour trouver tous ses films et séries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se buscan las fichas que ya abriste. Añade una clave de TMDb en Ajustes para encontrar todas sus películas y series."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só as páginas que você já abriu são pesquisadas. Adicione uma chave do TMDb em Ajustes para encontrar todos os filmes e séries dessa pessoa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会搜索你打开过的页面。在“设置”中添加 TMDb 密钥即可找到此人的所有电影和剧集。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبحث فقط في الصفحات التي فتحتها. أضف مفتاح TMDb في الإعدادات للعثور على كل أفلامه ومسلسلاته."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही पेज खोजे जाते हैं जो आपने खोले हैं। उनकी सभी फ़िल्में और सीरीज़ ढूँढने के लिए सेटिंग्स में TMDb कुंजी जोड़ें।"
          }
        }
      }
    },
