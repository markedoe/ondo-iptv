    "Watch on your TV or projector, or in Picture in Picture.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez sur votre TV ou vidéoprojecteur, ou en image dans l’image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira en tu TV o proyector, o con imagen dentro de imagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista na TV ou no projetor, ou em Picture in Picture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电视或投影仪上观看，或使用画中画。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد على تلفزيونك أو جهاز العرض، أو في وضع صورة داخل صورة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने टीवी या प्रोजेक्टर पर देखें, या पिक्चर इन पिक्चर में।"
          }
        }
      }
    },
    "Watch up to 4 channels at once. Only the highlighted one plays sound.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez jusqu'à 4 chaînes à la fois. Seule celle en surbrillance a le son."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira hasta 4 canales a la vez. Solo el resaltado tiene sonido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista a até 4 canais ao mesmo tempo. Só o canal destacado reproduz som."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多同时观看 4 个频道。仅高亮显示的频道会播放声音。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد حتى 4 قنوات في وقت واحد. لا يُسمع إلا صوت القناة المحددة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साथ 4 चैनल तक देखें। आवाज़ सिर्फ़ हाइलाइट किए गए चैनल की आती है।"
          }
        }
      }
    },
