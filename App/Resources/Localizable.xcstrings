    "Add channels, movies and series to your favorites to find them here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des chaînes, films et séries à vos favoris pour les retrouver ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade canales, películas y series a tus favoritos para encontrarlos aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione canais, filmes e séries aos favoritos para encontrá-los aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将频道、电影和剧集添加到收藏，即可在这里找到它们。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف القنوات والأفلام والمسلسلات إلى المفضلة لتجدها هنا."
