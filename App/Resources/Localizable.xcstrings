    "Multiview shows up to 4 channels. Close one to add another.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La multivue affiche jusqu'à 4 chaînes. Fermez-en une pour en ajouter une autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La multivista muestra hasta 4 canales. Cierra uno para añadir otro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A multitela mostra até 4 canais. Feche um para adicionar outro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多画面最多显示 4 个频道。关闭一个后才能添加其他频道。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض العرض المتعدد حتى 4 قنوات. أغلق إحداها لإضافة أخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मल्टीव्यू में ज़्यादा से ज़्यादा 4 चैनल दिखते हैं। दूसरा जोड़ने के लिए कोई एक बंद करें।"
          }
        }
      }
    },
