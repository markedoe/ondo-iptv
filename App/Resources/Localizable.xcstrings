          }
        }
      }
    },
    "Use the server address, username and password sent by your provider.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'adresse du serveur, l'identifiant et le mot de passe envoyés par votre fournisseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la dirección del servidor, el usuario y la contraseña que te envió tu proveedor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o endereço do servidor, o nome de usuário e a senha enviados pelo seu provedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用服务商发送给你的服务器地址、用户名和密码。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم عنوان الخادم واسم المستخدم وكلمة السر التي أرسلها مزوّدك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने प्रोवाइडर से मिला सर्वर पता, यूज़रनेम और पासवर्ड इस्तेमाल करें।"
          }
        }
      }
    },
    "Use “Add to Collection” on a movie, a series or a channel.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Ajouter à une collection » sur un film, une série ou une chaîne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Añadir a una colección» en una película, una serie o un canal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Adicionar a uma coleção” em um filme, uma série ou um canal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电影、剧集或频道上使用“添加到合集”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «إضافة إلى مجموعة» على فيلم أو مسلسل أو قناة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़िल्म, सीरीज़ या चैनल पर “संग्रह में जोड़ें” चुनें।"
          }
        }
      }
    },
    "Use “Add to My List” on a movie, a series or a channel to find it here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Ajouter à Ma liste » sur un film, une série ou une chaîne pour le retrouver ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Añadir a Mi lista» en una película, una serie o un canal para encontrarlo aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Adicionar à Minha lista” em um filme, uma série ou um canal para encontrá-lo aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电影、剧集或频道上使用“添加到我的片单”，即可在这里找到它。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «إضافة إلى قائمتي» على فيلم أو مسلسل أو قناة لتجده هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़िल्म, सीरीज़ या चैनल पर “मेरी सूची में जोड़ें” चुनें, वह यहाँ दिखेगा।"
          }
        }
      }
    },
    "Used to show the channel and to switch to it by typing its number.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché avec la chaîne et utilisé pour y accéder en tapant son numéro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra con el canal y permite ir a él escribiendo su número."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para exibir o canal e mudar para ele digitando o número."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与频道一同显示，输入此编号即可切换到该频道。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرض مع القناة ويُستخدم للانتقال إليها بكتابة رقمها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैनल के साथ दिखाया जाता है और नंबर टाइप करके उस चैनल पर जाने के लिए इस्तेमाल होता है।"
          }
        }
      }
    },
