    "Kids profiles never show locked or adult categories.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils enfant n'affichent jamais les catégories verrouillées ou adultes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles infantiles nunca muestran categorías bloqueadas ni para adultos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis infantis nunca mostram categorias bloqueadas ou adultas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "儿童个人资料从不显示已锁定的分类或成人分类。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تعرض ملفات الأطفال الشخصية الفئات المقفلة أو فئات البالغين أبدًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बच्चों की प्रोफ़ाइल में लॉक की गई या वयस्क श्रेणियाँ कभी नहीं दिखतीं।"
          }
        }
      }
    },
