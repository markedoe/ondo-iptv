    "Backups contain your playlists (including logins), My List, collections and history. Keep them private.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes contiennent vos playlists (identifiants compris), Ma liste, vos collections et votre historique. Gardez-les privées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad contienen tus playlists (con los datos de acceso), Mi lista, tus colecciones y tu historial. Guárdalas en privado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups contêm suas playlists (incluindo logins), a Minha lista, suas coleções e seu histórico. Mantenha-os privados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含你的播放列表（含登录信息）、我的片单、合集和历史记录。请妥善保管，切勿公开。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي النسخ الاحتياطية على قوائم التشغيل (بما فيها بيانات تسجيل الدخول) وقائمتي والمجموعات والسجل. لا تشاركها مع أحد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप में आपकी प्लेलिस्ट (लॉगिन सहित), मेरी सूची, संग्रह और इतिहास होते हैं। इन्हें निजी रखें।"
          }
        }
      }
    },
