        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum serviço de legendas configurado. Adicione uma chave em Ajustes > Legendas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置字幕服务。请在“设置 > 字幕”中添加密钥。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد أي خدمة ترجمة. أضف مفتاحًا في الإعدادات > الترجمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सबटाइटल सेवा सेट नहीं है। सेटिंग्स > सबटाइटल में कुंजी जोड़ें।"
          }
        }
      }
    },
    "No subtitles found. Check the title, or try another language.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun sous-titre trouvé. Vérifiez le titre ou essayez une autre langue."
