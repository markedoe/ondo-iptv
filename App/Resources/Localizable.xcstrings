          "stringUnit": {
            "state": "translated",
            "value": "O servidor do provedor retornou um erro (HTTP %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商的服务器返回了错误（HTTP %lld）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد خادم المزوّد خطأ (HTTP %lld)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर के सर्वर ने त्रुटि लौटाई (HTTP %lld)।"
          }
        }
      }
    },
    "The stream could not be opened, even with the VLC engine. It may be offline or blocked by the provider.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir le flux, même avec le moteur VLC. Il est peut-être hors ligne ou bloqué par le fournisseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la transmisión, ni siquiera con el motor VLC. Puede que no esté disponible o que el proveedor la bloquee."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o stream, nem com o motor VLC. Ele pode estar offline ou bloqueado pelo provedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使使用 VLC 引擎也无法打开此流。它可能已离线或被服务商屏蔽。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح البث، حتى باستخدام محرك VLC. ربما يكون غير متصل أو محظورًا من المزوّد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC इंजन से भी स्ट्रीम नहीं खुल सकी। हो सकता है वह ऑफ़लाइन हो या प्रोवाइडर ने उसे ब्लॉक किया हो।"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème"
          }
        },
        "es": {
          "stringUnit": {
