    "Control-click a channel and choose Hide Channel to remove it from lists, search and the guide.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle-cliquez sur une chaîne et choisissez Masquer la chaîne pour la retirer des listes, de la recherche et du guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz Control-clic en un canal y elige Ocultar canal para quitarlo de las listas, la búsqueda y la guía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-clique em um canal e escolha Ocultar canal para tirá-lo das listas, da busca e do guia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Control 点按频道并选择“隐藏频道”，即可将其从列表、搜索和节目指南中移除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مع الضغط على Control على قناة واختر إخفاء القناة لإزالتها من القوائم والبحث والدليل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को सूचियों, खोज और गाइड से हटाने के लिए उस पर Control-क्लिक करें और चैनल छिपाएँ चुनें।"
          }
        }
      }
    },
    "Control-click a channel and choose “Add to My List”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle-cliquez sur une chaîne et choisissez « Ajouter à Ma liste »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz Control-clic en un canal y elige «Añadir a Mi lista»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-clique em um canal e escolha “Adicionar à Minha lista”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Control 点按频道，然后选择“添加到我的片单”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مع الضغط على Control على قناة واختر «إضافة إلى قائمتي»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल पर Control-क्लिक करें और “मेरी सूची में जोड़ें” चुनें।"
          }
        }
      }
    },
    "Control-click a channel and choose “Add to My List”; it will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle-cliquez sur une chaîne et choisissez « Ajouter à Ma liste » ; elle apparaîtra ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz Control-clic en un canal y elige «Añadir a Mi lista»; aparecerá aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Control-clique em um canal e escolha “Adicionar à Minha lista”; ele aparecerá aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Control 点按频道并选择“添加到我的片单”，之后它会显示在这里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مع الضغط على Control على قناة واختر «إضافة إلى قائمتي»، وستظهر هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल पर Control-क्लिक करें और “मेरी सूची में जोड़ें” चुनें; वह यहाँ दिखेगा।"
          }
        }
      }
    },
