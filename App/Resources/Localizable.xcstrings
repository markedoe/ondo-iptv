    "The PINs do not match.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes PIN ne correspondent pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los PIN no coinciden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os PINs não coincidem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入的 PIN 不一致。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمزا PIN غير متطابقين."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN मेल नहीं खाते।"
          }
        }
      }
    },
    "The connection to the provider was lost. Resume the download to continue.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au fournisseur a été perdue. Reprenez le téléchargement pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión con el proveedor. Reanuda la descarga para continuar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o provedor foi perdida. Retome o download para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与服务商的连接已断开。请继续下载以完成。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال بالمزوّد. استأنف التنزيل للمتابعة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर से कनेक्शन टूट गया। आगे बढ़ने के लिए डाउनलोड जारी रखें।"
          }
        }
      }
    },
    "The largest collection, all languages. Get a key by creating an API consumer in your account. Without signing in, 5 downloads a day; your account raises the limit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plus grande collection, toutes langues. Obtenez une clé en créant un « API consumer » dans votre compte. Sans connexion, 5 téléchargements par jour ; votre compte relève cette limite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor colección, en todos los idiomas. Consigue una clave creando un “API consumer” en tu cuenta. Sin iniciar sesión, 5 descargas al día; con tu cuenta, el límite es mayor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O maior acervo, todos os idiomas. Obtenha uma chave criando um “API consumer” na sua conta. Sem login, 5 downloads por dia; sua conta aumenta o limite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收录最全，涵盖所有语言。在你的账户中创建 API consumer 即可获取密钥。未登录时每天可下载 5 次；登录账户可提高此限额。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكبر مجموعة، بجميع اللغات. احصل على مفتاح بإنشاء «API consumer» في حسابك. دون تسجيل الدخول، 5 تنزيلات يوميًا؛ ويرفع حسابك هذا الحد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे बड़ा संग्रह, सभी भाषाएँ। अपने खाते में API consumer बनाकर कुंजी पाएँ। साइन इन किए बिना रोज़ 5 डाउनलोड; आपके खाते से यह सीमा बढ़ जाती है।"
          }
        }
      }
    },
    "The movies, series and channels of your IPTV provider, in a clean library.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films, séries et chaînes de votre fournisseur IPTV, dans une bibliothèque claire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas, series y canales de tu proveedor de IPTV, en una biblioteca ordenada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os filmes, séries e canais do seu provedor de IPTV, em uma biblioteca organizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 IPTV 服务商提供的电影、剧集和频道，尽在简洁的资料库中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلام ومسلسلات وقنوات مزوّد IPTV الخاص بك، في مكتبة مرتّبة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके IPTV प्रोवाइडर की फ़िल्में, सीरीज़ और चैनल, एक साफ़-सुथरी लाइब्रेरी में।"
          }
        }
      }
    },
    "The picture is on your TV. The controls here still work.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image est sur votre téléviseur. Les commandes d’ici fonctionnent toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está en tu TV. Los controles de aquí siguen funcionando."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem está na sua TV. Os controles daqui continuam funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面正在你的电视上显示。此处的控制仍然有效。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة معروضة على تلفزيونك. لا تزال عناصر التحكم هنا تعمل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर आपके टीवी पर है। यहाँ के कंट्रोल अब भी काम करते हैं।"
          }
        }
      }
    },
    "The provider accepted the download but sends nothing yet. It may limit connections or downloads.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a accepté le téléchargement mais n'envoie encore rien. Il limite peut-être les connexions ou les téléchargements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor aceptó la descarga, pero todavía no envía nada. Puede que limite las conexiones o las descargas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor aceitou o download, mas ainda não envia nada. Ele pode limitar conexões ou downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商已接受下载请求，但尚未发送任何数据。它可能限制了连接数或下载。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبِل المزوّد التنزيل لكنه لا يرسل شيئًا بعد. ربما يقيّد الاتصالات أو التنزيلات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर ने डाउनलोड स्वीकार कर लिया, लेकिन अभी कुछ नहीं भेज रहा। हो सकता है वह कनेक्शन या डाउनलोड सीमित करता हो।"
          }
        }
      }
    },
    "The provider answered with an error (HTTP %lld).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a répondu par une erreur (HTTP %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor respondió con un error (HTTP %lld)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor respondeu com um erro (HTTP %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商返回了错误（HTTP %lld）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّ المزوّد بخطأ (HTTP %lld)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर ने त्रुटि के साथ जवाब दिया (HTTP %lld)।"
          }
        }
      }
    },
    "The provider answers normally, but this download receives nothing. Pause it, then resume it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur répond normalement, mais ce téléchargement ne reçoit rien. Mettez-le en pause, puis reprenez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor responde con normalidad, pero esta descarga no recibe nada. Ponla en pausa y luego reanúdala."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor responde normalmente, mas este download não recebe nada. Pause-o e depois retome-o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商响应正常，但此下载未收到任何数据。请先暂停，然后继续下载。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستجيب المزوّد بشكل طبيعي، لكن هذا التنزيل لا يستلم شيئًا. أوقفه مؤقتًا ثم استأنفه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर सामान्य रूप से जवाब दे रहा है, लेकिन इस डाउनलोड को कुछ नहीं मिल रहा। इसे पॉज़ करें, फिर जारी रखें।"
          }
        }
      }
    },
    "The provider refused access to this stream (HTTP %lld). Your subscription may have expired or the connection limit is reached.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a refusé l'accès à ce flux (HTTP %lld). Votre abonnement a peut-être expiré ou la limite de connexions est atteinte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor denegó el acceso a esta transmisión (HTTP %lld). Puede que tu suscripción haya caducado o que se haya alcanzado el límite de conexiones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor recusou o acesso a este stream (HTTP %lld). Sua assinatura pode ter expirado ou o limite de conexões foi atingido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商拒绝访问此流（HTTP %lld）。你的订阅可能已过期，或已达到连接数上限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد الوصول إلى هذا البث (HTTP %lld). ربما انتهى اشتراكك أو بلغت حد الاتصالات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर ने इस स्ट्रीम का ऐक्सेस नहीं दिया (HTTP %lld)। हो सकता है आपका सब्सक्रिप्शन समाप्त हो गया हो या कनेक्शन सीमा पूरी हो गई हो।"
          }
        }
      }
    },
    "The provider refused the download (HTTP %lld): expired subscription, connection limit reached (stop other playback) or downloads not allowed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur refuse le téléchargement (HTTP %lld) : abonnement expiré, limite de connexions atteinte (arrêtez les autres lectures) ou téléchargements non autorisés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor rechazó la descarga (HTTP %lld): suscripción caducada, límite de conexiones alcanzado (detén las otras reproducciones) o descargas no permitidas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor recusou o download (HTTP %lld): assinatura expirada, limite de conexões atingido (pare outras reproduções) ou downloads não permitidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商拒绝了下载（HTTP %lld）：订阅已过期、已达到连接数上限（请停止其他播放）或不允许下载。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض المزوّد التنزيل (HTTP %lld): اشتراك منتهٍ، أو بلوغ حد الاتصالات (أوقف عمليات التشغيل الأخرى)، أو التنزيلات غير مسموح بها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर ने डाउनलोड से मना कर दिया (HTTP %lld): सब्सक्रिप्शन समाप्त, कनेक्शन सीमा पूरी (दूसरे प्लेबैक रोकें) या डाउनलोड की अनुमति नहीं।"
          }
        }
      }
    },
    "The provider sent a message instead of the video: its connection limit may be reached, or it does not allow downloads.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a envoyé un message au lieu de la vidéo : sa limite de connexions est peut-être atteinte, ou il n'autorise pas les téléchargements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor envió un mensaje en lugar del video: puede que se haya alcanzado su límite de conexiones o que no permita descargas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor enviou uma mensagem em vez do vídeo: o limite de conexões pode ter sido atingido ou ele não permite downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商发送了一条消息而非视频：可能已达到其连接数上限，或其不允许下载。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل المزوّد رسالة بدلًا من الفيديو: ربما بلغ حد الاتصالات، أو أنه لا يسمح بالتنزيلات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर ने वीडियो की जगह एक संदेश भेजा: शायद उसकी कनेक्शन सीमा पूरी हो गई है, या वह डाउनलोड की अनुमति नहीं देता।"
          }
        }
      }
    },
    "The provider takes too long to answer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur met trop de temps à répondre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor tarda demasiado en responder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor está demorando demais para responder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商响应时间过长。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق المزوّد وقتًا طويلًا للرد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर जवाब देने में बहुत ज़्यादा समय ले रहा है।"
          }
        }
      }
    },
    "The provider's server cannot be reached.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du fournisseur est injoignable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al servidor del proveedor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor do provedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到服务商的服务器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خادم المزوّد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर के सर्वर तक नहीं पहुँचा जा सकता।"
          }
        }
      }
    },
    "The provider's server returned an error (HTTP %lld).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur du fournisseur a renvoyé une erreur (HTTP %lld)."
          }
