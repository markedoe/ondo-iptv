            "value": "थीम"
          }
        }
      }
    },
    "This channel is no longer in your playlist.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette chaîne n'est plus dans votre playlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este canal ya no está en tu playlist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este canal não está mais na sua playlist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此频道已不在你的播放列表中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هذه القناة موجودة في قائمة التشغيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चैनल अब आपकी प्लेलिस्ट में नहीं है।"
          }
        }
      }
    },
    "This file holds no subtitles that can be shown.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne contient aucun sous-titre affichable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no contiene subtítulos que se puedan mostrar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não contém legendas que possam ser exibidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不包含可显示的字幕。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الملف على ترجمة قابلة للعرض."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल में दिखाने लायक कोई सबटाइटल नहीं है।"
          }
        }
      }
    },
    "This file is no longer on the provider's server (HTTP %lld).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est plus sur le serveur du fournisseur (HTTP %lld)."
          }
        },
        "es": {
