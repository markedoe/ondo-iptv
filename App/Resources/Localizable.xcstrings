    "Your TV could not open this stream over AirPlay. Some providers only accept the device that opened it; for Xtream, the HLS (m3u8) format works best.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre téléviseur n’a pas pu ouvrir ce flux en AirPlay. Certains fournisseurs n’acceptent que l’appareil qui l’a ouvert ; pour Xtream, le format HLS (m3u8) fonctionne le mieux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu TV no pudo abrir esta transmisión por AirPlay. Algunos proveedores solo aceptan el dispositivo que la abrió; para Xtream, el formato HLS (m3u8) funciona mejor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua TV não conseguiu abrir este stream via AirPlay. Alguns provedores só aceitam o dispositivo que o abriu; para Xtream, o formato HLS (m3u8) funciona melhor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的电视无法通过 AirPlay 打开此流。某些服务商只接受最初打开该流的设备；对于 Xtream，HLS (m3u8) 格式效果最佳。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على تلفزيونك فتح هذا البث عبر AirPlay. بعض المزوّدين لا يقبلون إلا الجهاز الذي فتحه؛ وبالنسبة إلى Xtream، يعمل تنسيق HLS (m3u8) بشكل أفضل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका टीवी AirPlay पर यह स्ट्रीम नहीं खोल सका। कुछ प्रोवाइडर सिर्फ़ उसी डिवाइस को स्वीकार करते हैं जिसने इसे खोला था; Xtream के लिए HLS (m3u8) फ़ॉर्मैट सबसे अच्छा काम करता है।"
          }
        }
      }
    },
    "Your channels": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos chaînes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus canales"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus canais"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的频道"
          }
        },
        "ar": {
