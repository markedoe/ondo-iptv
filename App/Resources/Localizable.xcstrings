    "Some Chromecast devices refuse unencrypted (HTTP) live streams. If nothing plays, use AirPlay.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains Chromecast refusent les flux en direct non chiffrés (HTTP). Si rien ne s'affiche, utilisez AirPlay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos Chromecast rechazan las transmisiones en directo sin cifrar (HTTP). Si no se reproduce nada, usa AirPlay."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns dispositivos Chromecast recusam streams ao vivo não criptografados (HTTP). Se nada for reproduzido, use o AirPlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某些 Chromecast 设备会拒绝未加密（HTTP）的直播流。如果无法播放，请使用 AirPlay。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترفض بعض أجهزة Chromecast البث المباشر غير المشفّر (HTTP). إذا لم يُشغَّل شيء، فاستخدم AirPlay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ Chromecast डिवाइस बिना एन्क्रिप्शन वाली (HTTP) लाइव स्ट्रीम नहीं चलाते। अगर कुछ न चले, तो AirPlay इस्तेमाल करें।"
          }
        }
      }
    },
