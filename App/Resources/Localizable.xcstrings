    "Backups contain your playlists (including logins), favorites and history. Keep them private.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes contiennent vos playlists (identifiants compris), favoris et historique. Gardez-les privées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad contienen tus playlists (con los datos de acceso), favoritos e historial. Guárdalas en privado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups contêm suas playlists (incluindo logins), favoritos e histórico. Mantenha-os privados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含你的播放列表（含登录信息）、收藏和历史记录。请妥善保管，切勿公开。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي النسخ الاحتياطية على قوائم التشغيل (بما فيها بيانات تسجيل الدخول) والمفضلة والسجل. لا تشاركها مع أحد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप में आपकी प्लेलिस्ट (लॉगिन सहित), पसंदीदा और इतिहास होते हैं। इन्हें निजी रखें।"
          }
        }
