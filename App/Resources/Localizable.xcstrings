    "Its items in My List, collections and history will be removed too.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments de Ma liste, des collections et de l’historique seront aussi supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se eliminarán sus elementos de Mi lista, de las colecciones y del historial."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens dela em Minha lista, nas coleções e no histórico também serão removidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在“我的片单”、合集和观看记录中的内容也将被移除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
