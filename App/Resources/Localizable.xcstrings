    "Optional. Create a key on themoviedb.org. This product uses the TMDB API but is not endorsed or certified by TMDB.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Créez une clé sur themoviedb.org. Ce produit utilise l'API TMDB mais n'est ni approuvé ni certifié par TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Crea una clave en themoviedb.org. Este producto usa la API de TMDB, pero TMDB no lo respalda ni lo certifica."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Crie uma chave em themoviedb.org. Este produto usa a API do TMDB, mas não é endossado nem certificado pelo TMDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。请在 themoviedb.org 上创建密钥。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. أنشئ مفتاحًا على themoviedb.org. يستخدم هذا المنتج TMDB API، لكنه غير معتمد أو مصدَّق من TMDB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। themoviedb.org पर कुंजी बनाएँ। यह प्रोडक्ट TMDB API का इस्तेमाल करता है, लेकिन TMDB इसका समर्थन या प्रमाणन नहीं करता।"
          }
        }
      }
    },
