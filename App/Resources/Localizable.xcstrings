    "Too many connections for this subscription (HTTP %lld). Stop playback on this and your other devices, then resume the download.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de connexions pour cet abonnement (HTTP %lld). Arrêtez la lecture sur cet appareil et les autres, puis reprenez le téléchargement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas conexiones para esta suscripción (HTTP %lld). Detén la reproducción en este y en tus otros dispositivos y luego reanuda la descarga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexões demais para esta assinatura (HTTP %lld). Pare a reprodução neste e nos seus outros dispositivos e depois retome o download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此订阅的连接数过多（HTTP %lld）。请停止此设备及其他设备上的播放，然后继续下载。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد كبير جدًا من الاتصالات لهذا الاشتراك (HTTP %lld). أوقف التشغيل على هذا الجهاز وأجهزتك الأخرى، ثم استأنف التنزيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सब्सक्रिप्शन के लिए बहुत ज़्यादा कनेक्शन हैं (HTTP %lld)। इस और अपने दूसरे डिवाइस पर प्लेबैक रोकें, फिर डाउनलोड जारी रखें।"
          }
        }
      }
    },
    "Too many wrong PINs. Wait a moment and try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de PIN erronés. Patientez un moment avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados PIN incorrectos. Espera un momento y vuelve a intentarlo."
