      }
    },
    "This playlist has categories for %lld languages and countries. Keep %@ and hide the others? You can change this at any time in Settings, Categories.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette playlist a des catégories pour %lld langues et pays. Garder %@ et masquer les autres ? Vous pourrez changer cela à tout moment dans Réglages, Catégories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista tiene categorías para %lld idiomas y países. ¿Mantener %@ y ocultar los demás? Puedes cambiarlo en cualquier momento en Ajustes, Categorías."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta playlist tem categorias para %lld idiomas e países. Manter %@ e ocultar os outros? Você pode mudar isso a qualquer momento em Ajustes, Categorias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此播放列表包含 %lld 种语言和国家/地区的分类。保留%@并隐藏其他的？你可以随时在“设置”>“分类”中更改。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي قائمة التشغيل هذه على فئات لـ %lld من اللغات والبلدان. هل تريد إبقاء %@ وإخفاء البقية؟ يمكنك تغيير ذلك في أي وقت من الإعدادات، الفئات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्लेलिस्ट में %lld भाषाओं और देशों की श्रेणियाँ हैं। %@ रखें और बाकी छिपा दें? आप इसे कभी भी सेटिंग्स, श्रेणियाँ में बदल सकते हैं।"
          }
        }
      }
    },
    "This provider requires custom headers that a Chromecast can't send. The stream may not play.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur exige des en-têtes qu'un Chromecast ne peut pas envoyer. Le flux risque de ne pas se lancer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor requiere encabezados personalizados que un Chromecast no puede enviar. Puede que la transmisión no se reproduzca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor exige cabeçalhos personalizados que um Chromecast não consegue enviar. O stream pode não ser reproduzido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务商要求使用 Chromecast 无法发送的自定义标头。此流可能无法播放。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا المزوّد ترويسات مخصصة لا يستطيع Chromecast إرسالها. قد لا يعمل البث."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोवाइडर को कस्टम हेडर चाहिए, जो Chromecast नहीं भेज सकता। हो सकता है स्ट्रीम न चले।"
          }
        }
      }
    },
    "This stream does not exist on the provider's server (HTTP 404).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce flux n'existe pas sur le serveur du fournisseur (HTTP 404)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transmisión no existe en el servidor del proveedor (HTTP 404)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este stream não existe no servidor do provedor (HTTP 404)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商的服务器上不存在此流（HTTP 404）。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا البث غير موجود على خادم المزوّد (HTTP 404)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्ट्रीम प्रोवाइडर के सर्वर पर मौजूद नहीं है (HTTP 404)।"
          }
        }
      }
    },
    "This stream format (TS, MKV, AVI…) can't be played by a Chromecast. Use AirPlay, or choose the HLS (m3u8) format for Xtream playlists.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format (TS, MKV, AVI…) n'est pas lisible par un Chromecast. Utilisez AirPlay, ou choisissez le format HLS (m3u8) pour les playlists Xtream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Chromecast no puede reproducir este formato de transmisión (TS, MKV, AVI…). Usa AirPlay o elige el formato HLS (m3u8) para las playlists Xtream."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de stream (TS, MKV, AVI…) não pode ser reproduzido por um Chromecast. Use o AirPlay ou escolha o formato HLS (m3u8) para playlists Xtream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chromecast 无法播放此流格式（TS、MKV、AVI…）。请使用 AirPlay，或为 Xtream 播放列表选择 HLS (m3u8) 格式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Chromecast تشغيل تنسيق البث هذا (TS، MKV، AVI…). استخدم AirPlay، أو اختر تنسيق HLS (m3u8) لقوائم تشغيل Xtream."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्ट्रीम फ़ॉर्मैट (TS, MKV, AVI…) Chromecast पर नहीं चल सकता। AirPlay इस्तेमाल करें, या Xtream प्लेलिस्ट के लिए HLS (m3u8) फ़ॉर्मैट चुनें।"
          }
        }
      }
    },
    "This stream format is not supported by the built-in player. For Xtream playlists, select the HLS (m3u8) output format in the playlist settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format de flux n'est pas pris en charge par le lecteur intégré. Pour une playlist Xtream, choisissez le format HLS (m3u8) dans les réglages de la playlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor integrado no admite este formato de transmisión. Para las playlists Xtream, elige el formato de salida HLS (m3u8) en los ajustes de la playlist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de stream não é compatível com o player integrado. Para playlists Xtream, selecione o formato de saída HLS (m3u8) nos ajustes da playlist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置播放器不支持此流格式。对于 Xtream 播放列表，请在播放列表设置中选择 HLS (m3u8) 输出格式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق البث هذا غير مدعوم في المشغّل المدمج. لقوائم تشغيل Xtream، اختر تنسيق الإخراج HLS (m3u8) في إعدادات قائمة التشغيل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ट-इन प्लेयर इस स्ट्रीम फ़ॉर्मैट को सपोर्ट नहीं करता। Xtream प्लेलिस्ट के लिए, प्लेलिस्ट सेटिंग्स में HLS (m3u8) आउटपुट फ़ॉर्मैट चुनें।"
          }
        }
      }
    },
    "This stream is played by VLC, which shows the picture on this device only. The Apple engine can send it to your TV if it can open the stream.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce flux est lu par VLC, qui n’affiche l’image que sur cet appareil. Le moteur Apple peut l’envoyer sur votre téléviseur s’il sait ouvrir le flux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transmisión se reproduce con VLC, que solo muestra la imagen en este dispositivo. El motor de Apple puede enviarla a tu TV si consigue abrirla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este stream é reproduzido pelo VLC, que mostra a imagem somente neste dispositivo. O motor Apple pode enviá-lo para sua TV se conseguir abrir o stream."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此流由 VLC 播放，画面只能显示在本设备上。如果 Apple 引擎能打开此流，则可将其发送到你的电视。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُشغَّل هذا البث بواسطة VLC، الذي يعرض الصورة على هذا الجهاز فقط. يمكن لمحرك Apple إرساله إلى تلفزيونك إذا استطاع فتح البث."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्ट्रीम VLC से चल रही है, जो तस्वीर सिर्फ़ इसी डिवाइस पर दिखाता है। अगर Apple इंजन यह स्ट्रीम खोल सके, तो वह इसे आपके टीवी पर भेज सकता है।"
          }
        }
      }
    },
