    "Locked categories are hidden from home, search and favorites, and ask for the PIN when opened.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories verrouillées sont masquées de l'accueil, de la recherche et des favoris, et demandent le code PIN à l'ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías bloqueadas no aparecen en Inicio, la búsqueda ni los favoritos, y piden el PIN al abrirlas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorias bloqueadas ficam ocultas no Início, na busca e nos favoritos, e pedem o PIN ao serem abertas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定的分类不会显示在首页、搜索和收藏中，打开时需要输入 PIN。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخفى الفئات المقفلة من الرئيسية والبحث والمفضلة، ويُطلب رمز PIN عند فتحها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक की गई श्रेणियाँ होम, खोज और पसंदीदा में नहीं दिखतीं, और खोलने पर PIN माँगती हैं।"
          }
        }
      }
    },
    "Long-press a channel and choose Hide Channel to remove it from lists, search and the guide.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une chaîne et choisissez Masquer la chaîne pour la retirer des listes, de la recherche et du guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un canal y elige Ocultar canal para quitarlo de las listas, la búsqueda y la guía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um canal e escolha Ocultar canal para removê-lo das listas, da busca e do guia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按频道并选择“隐藏频道”，即可将其从频道列表、搜索和节目指南中移除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على قناة واختر «إخفاء القناة» لإزالتها من القوائم والبحث ودليل البرامج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को सूचियों, खोज और गाइड से हटाने के लिए उसे देर तक दबाएँ और चैनल छिपाएँ चुनें।"
          }
        }
      }
    },
    "Long-press a channel to add it to your favorites.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long sur une chaîne pour l'ajouter à vos favoris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un canal para añadirlo a tus favoritos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um canal para adicioná-lo aos favoritos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按频道即可将其添加到收藏。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على قناة لإضافتها إلى المفضلة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को पसंदीदा में जोड़ने के लिए उसे देर तक दबाएँ।"
          }
        }
      }
    },
    "Long-press a channel to add it to your favorites; it will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur une chaîne pour l'ajouter à vos favoris ; elle apparaîtra ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado un canal para añadirlo a tus favoritos; aparecerá aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure um canal para adicioná-lo aos favoritos; ele aparecerá aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按频道即可将其添加到收藏，之后它会显示在这里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على قناة لإضافتها إلى المفضلة، وستظهر هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चैनल को पसंदीदा में जोड़ने के लिए उसे देर तक दबाएँ; वह यहाँ दिखेगा।"
          }
        }
      }
    },
