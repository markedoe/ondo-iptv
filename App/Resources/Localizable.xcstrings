    "Open Live TV to browse channels. Long-press a channel to add it to your favorites; it will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez TV en direct pour parcourir les chaînes. Appui long sur une chaîne pour l'ajouter aux favoris : elle apparaîtra ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre TV en directo para explorar los canales. Mantén presionado un canal para añadirlo a tus favoritos; aparecerá aquí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra TV ao vivo para navegar pelos canais. Toque e segure um canal para adicioná-lo aos favoritos; ele aparecerá aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“直播”浏览频道。长按频道即可将其添加到收藏，之后它会显示在这里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح البث المباشر لتصفح القنوات. اضغط مطولًا على قناة لإضافتها إلى المفضلة، وستظهر هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैनल ब्राउज़ करने के लिए लाइव टीवी खोलें। किसी चैनल को पसंदीदा में जोड़ने के लिए उसे देर तक दबाएँ; वह यहाँ दिखेगा।"
          }
        }
      }
    },
    "Open a programme in the TV guide and choose Remind Me.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un programme dans le guide TV et choisissez Me le rappeler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un programa en la guía de TV y elige Recordármelo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um programa no guia de TV e escolha Lembrar-me."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在节目指南中打开一个节目，然后选择“提醒我”。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح برنامجًا في دليل البرامج واختر «ذكّرني»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टीवी गाइड में कोई कार्यक्रम खोलें और याद दिलाएँ चुनें।"
          }
        }
      }
    },
