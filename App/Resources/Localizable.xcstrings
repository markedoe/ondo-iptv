    "Downloaded files can't be sent to a Chromecast. Use AirPlay instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers téléchargés ne peuvent pas être envoyés à un Chromecast. Utilisez AirPlay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos descargados no se pueden enviar a un Chromecast. Usa AirPlay."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos baixados não podem ser enviados a um Chromecast. Use o AirPlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的文件无法发送到 Chromecast，请改用 AirPlay。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إرسال الملفات المنزّلة إلى Chromecast. استخدم AirPlay بدلًا من ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड की गई फ़ाइलें Chromecast पर नहीं भेजी जा सकतीं। इसकी जगह AirPlay इस्तेमाल करें।"
          }
        }
      }
    },
