    "Reminders are kept with your favorites and follow your profile on your other devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont gardés avec vos favoris et suivent votre profil sur vos autres appareils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se guardan con tus favoritos y siguen a tu perfil en tus otros dispositivos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes ficam com seus favoritos e acompanham seu perfil nos seus outros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒与收藏一同保存，并随你的个人资料同步到其他设备。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ التذكيرات مع المفضلة وتتبع ملفك الشخصي على أجهزتك الأخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर आपके पसंदीदा के साथ रखे जाते हैं और आपके दूसरे डिवाइस पर भी आपकी प्रोफ़ाइल के साथ रहते हैं।"
          }
        }
      }
    },
