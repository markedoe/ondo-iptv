{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description (the system's permission prompt)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondo looks for Chromecast and AirPlay devices on your network so you can watch on a TV or projector, and plays streams served from your local network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondo recherche les appareils Chromecast et AirPlay de votre réseau pour que vous puissiez regarder sur une TV ou un projecteur, et lit les flux servis par votre réseau local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondo busca dispositivos Chromecast y AirPlay en tu red para que puedas ver en un televisor o un proyector, y reproduce las transmisiones servidas desde tu red local."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ondo procura dispositivos Chromecast e AirPlay na sua rede para você assistir em uma TV ou projetor, e reproduz as transmissões servidas pela sua rede local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondo 会在你的网络中查找 Chromecast 和 AirPlay 设备，以便你在电视或投影仪上观看，并播放来自本地网络的流。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث Ondo عن أجهزة Chromecast وAirPlay على شبكتك لتتمكن من المشاهدة على تلفاز أو جهاز عرض، ويشغّل البث المقدَّم من شبكتك المحلية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondo आपके नेटवर्क पर Chromecast और AirPlay डिवाइस खोजता है ताकि आप टीवी या प्रोजेक्टर पर देख सकें, और आपके लोकल नेटवर्क से आने वाली स्ट्रीम चलाता है।"
          }
        }
      }
    }
  },
  "version": "1.0"
}