<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11 (data_extraction_rules.xml covers 12 and later): nothing leaves the device either,
     playlists may hold provider logins. allowBackup="false" already turns backups off; this states it. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
