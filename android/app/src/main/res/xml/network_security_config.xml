<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV providers overwhelmingly serve playlists, logos and streams over plain HTTP from their own servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
