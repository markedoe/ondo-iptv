<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ondo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <!-- No bar colours here (deprecated from Android 15): each activity calls enableEdgeToEdge(). -->
    </style>

    <style name="Theme.Ondo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Ondo</item>
    </style>

    <style name="Theme.Ondo.Player" parent="Theme.Ondo">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
