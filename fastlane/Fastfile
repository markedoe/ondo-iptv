# Delivery lanes for Ondo: App Store (iOS + macOS share one bundle ID: universal purchase), run by
# .github/workflows/release.yml, and Google Play, run by .github/workflows/release-android.yml.
#
# Required environment (GitHub secrets in CI, see docs/RELEASE.md and docs/RELEASE-ANDROID.md):
#   ios / mac lanes: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (the App Store Connect API key: a Team key with the
#   Admin role, which cloud-managed signing needs; the .p8 file content as is, or base64 encoded), and for the
#   beta lanes DEVELOPMENT_TEAM (Apple team ID).
#   android lanes: PLAY_SERVICE_ACCOUNT_JSON (Google Play service account key); deploy also reads TRACK
#   (default internal) and RELEASE_STATUS (default completed, internal track only); promote reads VERSION_CODE,
#   TRACK, RELEASE_STATUS (default completed) and KEEP_PLAY_REVIEW (true: refused while changes are in review).
# Apple signing is automatic: Xcode uses the API key to create/download cloud-managed certificates and profiles.
#
# Paths: Ruby code and `sh` run in fastlane/, actions (deliver, gym…) from the repository root.

require "base64"
require "digest"
require "openssl"
require "set"
require "tmpdir"

default_platform(:ios)

APP_ID = "com.markedoe.ondo"
PROJECT = "Ondo.xcodeproj"
SCHEME = "Ondo"

# The PEM text of the key, whether the secret holds the file content or its base64.
def key_pem
  value = ENV.fetch("ASC_KEY_P8").strip
  value.include?("BEGIN PRIVATE KEY") ? "#{value}\n" : Base64.decode64(value)
end

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: key_pem,
    is_key_content_base64: false,
    in_house: false
  )
end

# The key as a file, for xcodebuild's -authenticationKeyPath: outside the checkout (the runner's temporary
# folder in CI), readable by this user only, deleted when the lane ends (after_all / error below).
KEY_FILE = File.join(ENV["RUNNER_TEMP"] || Dir.tmpdir, "ondo_asc_key.p8")

def key_file
  File.delete(KEY_FILE) if File.exist?(KEY_FILE)
  File.write(KEY_FILE, key_pem, perm: 0o600)
  KEY_FILE
end

def remove_key_file
  File.delete(KEY_FILE) if File.exist?(KEY_FILE)
end

# Lets xcodebuild create and fetch cloud-managed certificates and profiles. gym passes xcargs to both
# the archive and the export, so these flags must not be repeated in export_xcargs (xcodebuild rejects them twice).
def authentication_xcargs
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{key_file}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  ].join(" ")
end

def signing_xcargs
  "#{authentication_xcargs} DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')} CODE_SIGN_STYLE=Automatic"
end

# The release workflow generates the project with XcodeGen in a step of its own, without the signing secrets; on a
# Mac, run `xcodegen generate` first.
def require_project
  return if File.directory?(File.expand_path("../#{PROJECT}", __dir__))
  UI.user_error!("#{PROJECT} is missing: run `xcodegen generate` at the repository root first")
end

# Build number: the platform's latest upload on App Store Connect + 1 (1 for the first one), so a re-run or
# an upload made by hand is never reused. An API error (key, missing app) stops the lane here, before a long
# build that App Store Connect would refuse.
# AFTER_BUILD_NUMBER: the build this run uploaded just before (a push's App Store edition, before its TestFlight
# edition), which App Store Connect may not list yet while it processes it.
def next_build_number(platform)
  latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, platform: platform, initial_build_number: 0)
  [latest.to_i, ENV.fetch("AFTER_BUILD_NUMBER", "0").to_i].max + 1
end

# The version comes from the tag (v1.2.3 → 1.2.3); without one (a manual run on a branch, even one whose name starts
# with v), project.yml's MARKETING_VERSION is kept. A v tag that is not a version stops the lane: its builds would
# otherwise go to project.yml's version.
def marketing_version
  return nil unless ENV["GITHUB_REF_TYPE"] == "tag"
  tag = ENV["GITHUB_REF_NAME"].to_s
  return nil unless tag.start_with?("v")
  UI.user_error!("Tag #{tag} is not a version (v1.2 or v1.2.3)") unless tag.match?(/\Av\d+(\.\d+){1,2}\z/)
  tag.delete_prefix("v")
end

# The App Store version the listing goes to, the same as the builds': the tag's, otherwise project.yml's.
def app_version
  marketing_version || File.read(File.expand_path("../project.yml", __dir__), encoding: "UTF-8")[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
end

def build_settings_args(build_number)
  args = ["CURRENT_PROJECT_VERSION=#{build_number}"]
  args << "MARKETING_VERSION=#{marketing_version}" if marketing_version
  # The TestFlight edition has downloads (FeatureFlags.downloads); the App Store edition, the one submitted, has not.
  args << "'SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) TESTFLIGHT_DOWNLOADS'" if testflight_edition?
  args.join(" ")
end

# EDITION from the release workflow: "testflight" for testers, anything else builds the App Store edition.
def testflight_edition?
  ENV["EDITION"] == "testflight"
end

# EDITION "app-store": the edition submitted for App Review, the only one external testers get.
def app_store_edition?
  ENV["EDITION"] == "app-store"
end

# A version tag's release waits until App Store Connect has processed the build (minutes to half an hour): only a
# processed build can be selected for review. Pushes to main do not wait.
def wait_for_processing?
  ENV["WAIT_FOR_PROCESSING"] == "true"
end

# Uploads to TestFlight, waiting for the processing when the build is to be submitted (no tester group is notified).
def upload_build(platform)
  upload_to_testflight(
    api_key: api_key,
    app_platform: platform,
    skip_waiting_for_build_processing: !wait_for_processing?,
    skip_submission: true,
    wait_processing_timeout_duration: 5400
  )
end

# TestFlight e-mails every tester for each new build unless the build's "notify testers" is off: Ondo's uploads
# turn it off (testers find each build in the TestFlight app). Set while App Store Connect still processes the
# build, before it is offered. Best effort: a failure here leaves the upload as it is.
def quiet_testers(platform, number)
  api_key # also authorizes Spaceship::ConnectAPI
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  detail = nil
  40.times do
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: number.to_s, platform: Spaceship::ConnectAPI::Platform.map(platform)).first
    detail = build&.build_beta_detail
    break if detail
    sleep 15
  end
  if detail
    Spaceship::ConnectAPI.patch_build_beta_details(build_beta_details_id: detail.id, attributes: { autoNotifyEnabled: false })
    UI.message("Build #{number}: testers are not e-mailed")
  else
    UI.important("Build #{number} not found on App Store Connect yet: testers may be e-mailed for it")
  end
rescue StandardError => e
  UI.important("Build #{number}: could not turn off the testers' e-mail (#{e.message})")
end

# The build this lane uploaded (or was given), once App Store Connect lists it: up to 10 minutes after the upload.
def listed_build(app, platform, number)
  40.times do
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: number.to_s, platform: Spaceship::ConnectAPI::Platform.map(platform)).first
    return build if build
    sleep 15
  end
  nil
end

# What to Test, the same on every build of both editions, internal and external, iOS and macOS, pushes and tags: the
# listing's release notes in each of its languages. Only the build's localizations change: nothing is distributed or
# submitted. Each language on its own: one App Store Connect refuses is reported and the others are still set. Returns
# the problems (empty when every language is set); the beta lanes report them as ::error:: lines and the step output
# what_to_test=missing, which step What to Test of release.yml turns into a failed run, and leave the upload as it is.
def fill_what_to_test(platform, number)
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  build = listed_build(app, platform, number)
  return ["build #{number} not listed by App Store Connect after 10 minutes"] unless build
  existing = build.get_beta_build_localizations.to_h { |localization| [localization.locale, localization] }
  refused = []
  whats_new_texts.each do |locale, text|
    # TestFlight refuses "<" in What to Test (fastlane's own upload leaves it out too).
    attributes = { whatsNew: text.gsub("<", "")[0, 4000] }
    if existing[locale]
      Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: existing[locale].id, attributes: attributes)
    else
      Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: attributes.merge(locale: locale))
    end
  rescue StandardError => e
    refused << "#{locale}: #{e.message.lines.first.to_s.strip}"
  end
  set = whats_new_texts.keys - refused.map { |problem| problem.split(":", 2).first }
  UI.message("Build #{number} (#{platform}): What to Test set in #{set.join(', ')}")
  refused.map { |problem| "What to Test refused in #{problem}" }
rescue StandardError => e
  ["What to Test not set (#{e.message.lines.first.to_s.strip})"]
end

def report_what_to_test(platform, number)
  problems = fill_what_to_test(platform, number)
  return if problems.empty?
  problems.each { |problem| puts "::error::Build #{number} (#{platform}): #{problem}" }
  File.write(ENV["GITHUB_OUTPUT"], "what_to_test=missing\n", mode: "a") if ENV["GITHUB_OUTPUT"]
end

# The build number of this upload for the steps after it (the submission in release.yml).
def report_build_number(number)
  File.write(ENV["GITHUB_OUTPUT"], "build=#{number}\n", mode: "a") if ENV["GITHUB_OUTPUT"]
  UI.message("Build number #{number}")
end

# External testers (CLAUDE.md, App Store): the App Store edition of each push to main, the build App Review would get,
# goes to every external TestFlight group of the app through Apple's Beta App Review (EXTERNAL_GROUP is created only when
# the app has none). The TestFlight edition (downloads) stays with internal testers: nothing else in this file
# distributes a build externally or submits one for beta review.
EXTERNAL_GROUP = "External testers"
# The release notes and the description of the listing, the same texts and languages as the App Store's (checked by
# check_app_store.py): What to Test and the beta app description.
METADATA_DIR = File.expand_path("metadata", __dir__)

def listing_texts(file)
  Dir[File.join(METADATA_DIR, "*", file)].sort.to_h do |path|
    [File.basename(File.dirname(path)), File.read(path, encoding: "UTF-8").strip[0, 4000]]
  end.reject { |_locale, text| text.empty? }
end

def whats_new_texts
  listing_texts("release_notes.txt")
end

def tester_count(group)
  Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: group.id }, limit: 200).all_pages.sum { |page| page.to_models.size }
rescue StandardError => e
  "unknown (#{e.message})"
end

# The request that creates EXTERNAL_GROUP (POST /v1/betaGroups): its name, external, and the app; nothing else.
# Spaceship's create_beta_group also sends publicLinkLimit, which App Store Connect refuses while the public link is off
# ("Public link limit cannot be changed when public link is disabled").
def new_external_group_body(app_id)
  {
    data: {
      type: "betaGroups",
      attributes: { name: EXTERNAL_GROUP, isInternalGroup: false },
      relationships: { app: { data: { type: "apps", id: app_id } } }
    }
  }
end

# The external groups of the app, as App Store Connect holds them (each logged: name, testers, public link): every one
# gets the App Store edition build. Never an internal group (the TestFlight edition's). EXTERNAL_GROUP is created only
# when the app has no external group at all (testers are added in App Store Connect, never from here).
def external_groups(app)
  groups = app.get_beta_groups
  groups.select(&:is_internal_group).each { |group| UI.message("Group \"#{group.name}\": internal, #{tester_count(group)} testers (not used)") }
  external = groups.reject(&:is_internal_group)
  if external.empty?
    UI.user_error!("The TestFlight group \"#{EXTERNAL_GROUP}\" is an internal group: rename it in App Store Connect") if groups.any? { |group| group.name == EXTERNAL_GROUP }
    UI.important("No external TestFlight group: creating \"#{EXTERNAL_GROUP}\" (add its testers in App Store Connect)")
    Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", new_external_group_body(app.id))
    external = app.get_beta_groups.reject(&:is_internal_group)
    UI.user_error!("The TestFlight group \"#{EXTERNAL_GROUP}\" could not be created") if external.empty?
  end
  external.each do |group|
    UI.message("Group \"#{group.name}\": external, #{tester_count(group)} testers, public link #{group.public_link_enabled ? 'on' : 'off'}")
  end
  UI.user_error!("An internal group was selected for external testers") if external.any?(&:is_internal_group)
  external
end

# iOS builds on Macs with Apple silicon (App Store Connect API, betaGroups.iosBuildsAvailableForAppleSiliconMac): a
# setting of each TestFlight group, for all its builds. Ondo has a Mac app under the same bundle ID: TestFlight on a Mac
# installs the iOS build otherwise, and the Mac build then refuses to install until it is deleted. Spaceship's
# BetaGroup model drops the attribute, so it is read from the response: group id → [name, true / false / nil].
def mac_testing_by_group(app)
  Spaceship::ConnectAPI.get_beta_groups(filter: { app: app.id }).all_pages.flat_map { |page| page.body["data"] || [] }.to_h do |data|
    attributes = data["attributes"] || {}
    [data["id"], [attributes["name"], attributes["iosBuildsAvailableForAppleSiliconMac"]]]
  end
end

def mac_testing_text(value)
  value.nil? ? "not returned by the API" : (value ? "on" : "off")
end

# Turns the setting off in each group where it is on, and only there (logged). Best effort: a refusal leaves the group
# as it is and the distribution goes on. Only the TestFlight groups change: never the App Store availability or a version.
def keep_ios_builds_off_macs(app)
  mac_testing_by_group(app).each do |id, (name, value)|
    next unless value == true
    Spaceship::ConnectAPI.patch_group(group_id: id, attributes: { iosBuildsAvailableForAppleSiliconMac: false })
    UI.important("Group \"#{name}\": iOS builds no longer offered on Apple silicon Macs (the Mac app is)")
  rescue StandardError => e
    puts "::warning::Group \"#{name}\": could not stop offering iOS builds on Apple silicon Macs (#{e.message})"
  end
rescue StandardError => e
  puts "::warning::Could not read the TestFlight groups' Apple silicon Mac setting (#{e.message})"
end

# Beta App Review needs a contact: the App Review contact App Store Connect already holds, copied when the beta review
# details have none. Neither is in the repository nor printed (the log of a public repository is public).
def beta_review_contact(app)
  fields = %i[contact_first_name contact_last_name contact_phone contact_email]
  detail = Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }).to_models.first
  present = detail && fields.all? { |field| !detail.send(field).to_s.empty? }
  UI.message("Beta App Review contact: #{present ? 'set' : 'missing, copied from the App Review contact'}")
  return if present
  review = PLATFORMS.values.lazy.flat_map do |platform, _folder|
    app.get_app_store_versions(filter: { platform: platform }, includes: "appStoreReviewDetail").map(&:app_store_review_detail)
  end.find { |candidate| candidate && fields.all? { |field| !candidate.send(field).to_s.empty? } }
  missing = fields.reject { |field| detail && !detail.send(field).to_s.empty? }.map { |field| field.to_s.sub("contact_", "").tr("_", " ") }
  UI.user_error!("App Store Connect → TestFlight → Test Information → Beta App Review Information: #{missing.join(', ')} " \
                 "empty, and no complete App Review contact to copy") unless review
  Spaceship::ConnectAPI.patch_beta_app_review_detail(app_id: app.id, attributes: {
    contactFirstName: review.contact_first_name, contactLastName: review.contact_last_name,
    contactPhone: review.contact_phone, contactEmail: review.contact_email
  })
  UI.message("Beta App Review contact: the App Review contact")
end

# External testers send their feedback to the beta app's feedback e-mail, which is not in the repository (CLAUDE.md,
# Privacy): read from App Store Connect (logged as set or missing, never printed) and reused for every language.
def feedback_email(app)
  localizations = app.get_beta_app_localizations
  email = localizations.map(&:feedback_email).find { |value| !value.to_s.empty? }
  UI.message("Test Information: feedback e-mail #{email ? 'set' : 'missing'} (#{localizations.map(&:locale).sort.join(', ')})")
  return email if email
  UI.user_error!("App Store Connect → TestFlight → Test Information → Feedback Email is empty in every language: " \
                 "external testing needs it")
end

# Test Information of the beta app (description, feedback e-mail, privacy and marketing addresses), one language at a
# time: one App Store Connect refuses is reported and the others are still set. Returns the problems.
def beta_test_information(app, email)
  existing = app.get_beta_app_localizations.to_h { |localization| [localization.locale, localization] }
  privacy = listing_texts("privacy_url.txt")
  marketing = listing_texts("marketing_url.txt")
  listing_texts("description.txt").filter_map do |locale, text|
    attributes = { description: text, feedbackEmail: email, privacyPolicyUrl: privacy[locale], marketingUrl: marketing[locale] }.compact
    if existing[locale]
      Spaceship::ConnectAPI.patch_beta_app_localizations(localization_id: existing[locale].id, attributes: attributes)
    else
      Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: attributes.merge(locale: locale))
    end
    nil
  rescue StandardError => e
    "Test Information refused in #{locale}: #{e.message.lines.first.to_s.strip}"
  end
end

# Whether a build is attached to an App Store version (selected for App Review, or released): such a build is never
# expired here, whatever its beta review state.
def app_store_version_build?(build)
  response = Spaceship::ConnectAPI.get_build(build_id: build.id, includes: "appStoreVersion")
  !response.body.dig("data", "relationships", "appStoreVersion", "data").nil?
end

# Apple reviews one build of a version at a time; checked once this build is processed. A build of this version and
# platform still waiting for Beta App Review is expired (the newer one replaces it; only App Store edition builds are
# ever submitted), unless an App Store version uses it: then the lane stops. One in review is left alone, and this
# build waits for the next push (false).
def beta_review_slot_free?(app, platform, version, number)
  waiting = app.get_builds(
    filter: { "betaAppReviewSubmission.betaReviewState" => "WAITING_FOR_REVIEW,IN_REVIEW", "expired" => false,
              "preReleaseVersion.version" => version, "preReleaseVersion.platform" => Spaceship::ConnectAPI::Platform.map(platform) },
    includes: "betaAppReviewSubmission,preReleaseVersion"
  ).reject { |build| build.version == number }
  if waiting.any? { |build| build.beta_app_review_submission&.beta_review_state == "IN_REVIEW" }
    UI.important("A #{platform} build of #{version} is in Beta App Review: this one is not sent; the next push's build follows it")
    return false
  end
  waiting.each do |build|
    if app_store_version_build?(build)
      UI.user_error!("Build #{build.version} (#{platform} #{version}) waits for Beta App Review and is attached to an App " \
                     "Store version: it is not expired; nothing is sent")
    end
    UI.important("Build #{build.version} (#{platform} #{version}) was waiting for Beta App Review: replaced by this one")
    build.expire!
  end
  true
end

# The App Store edition build BUILD_NUMBER (uploaded by a push's Release run, given by testflight-external.yml) → the
# external groups, through Beta App Review. Never App Review: the App Store version and its submission are not changed.
# Never a tag's build (the tag submitted its App Store edition for App Review). Waits for the processing first, then
# frees the beta review slot, fills Test Information and What to Test language by language, submits and adds the build
# to every external group; a refused language fails the lane at the end, once the others are set and the build is sent.
def distribute_to_external_testers(platform)
  UI.user_error!("Only the App Store edition goes to external testers (EDITION=app-store)") unless app_store_edition?
  UI.user_error!("A tag's build never goes to external testers: only a push to main's") if ENV["GITHUB_REF_TYPE"] == "tag"
  build = ENV.fetch("BUILD_NUMBER", "").strip
  UI.user_error!("BUILD_NUMBER must be the App Store edition build of a push's Release run") unless build.match?(/\A\d+\z/)
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  version = app_version
  groups = external_groups(app)
  # Once, for every group of the app (internal ones included), before the build is offered anywhere.
  keep_ios_builds_off_macs(app)
  beta_review_contact(app)
  email = feedback_email(app)
  FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
    app_id: app.id, platform: platform, app_version: version, build_version: build,
    timeout_duration: 5400, return_spaceship_testflight_build: false
  )
  return unless beta_review_slot_free?(app, platform, version, build)
  problems = beta_test_information(app, email) + fill_what_to_test(platform, build)
  upload_to_testflight(
    api_key: api_key,
    app_identifier: APP_ID,
    app_platform: platform,
    distribute_only: true,
    app_version: version,
    build_number: build,
    wait_processing_timeout_duration: 5400,
    distribute_external: true,
    # By id: the external groups only, whatever their names (an internal group may share one).
    groups: groups.map(&:id),
    submit_beta_review: true,
    reject_build_waiting_for_review: false,
    notify_external_testers: true,
    uses_non_exempt_encryption: false,
    demo_account_required: false,
    beta_app_review_info: { notes: File.read(File.join(METADATA_DIR, "review_information/notes.txt"), encoding: "UTF-8").strip[0, 4000] }
  )
  UI.success("Build #{build} (#{platform} #{version}): sent to #{groups.map { |group| "\"#{group.name}\"" }.join(', ')} through Beta App Review")
  problems.each { |problem| puts "::error::Build #{build} (#{platform}): #{problem}" }
  UI.user_error!("#{problems.size} language(s) refused by App Store Connect (see the errors above)") unless problems.empty?
end

# The tips' In-App Purchases (App/Model/Tips.swift): Apple reviews a first In-App Purchase together with an app
# version, in the same review submission. deliver cannot add them (it refuses a submission holding other items), so
# when tips are waiting (READY_TO_SUBMIT, and StoreKit in the App Store edition's build) deliver uploads without
# submitting and asset_library.py iap_submit sends the version and the tips together. None waiting (approved, with
# App Review, or an App Store edition without the tips): deliver submits as before.
ASSET_LIBRARY = File.expand_path("../.github/scripts/asset_library.py", __dir__)
API_PLATFORMS = { "ios" => "IOS", "osx" => "MAC_OS" }.freeze

# Fails (asset_library.py ends on an error) when the App Store edition sells the tips and one is not ready.
def tips_to_submit?(platform)
  output = sh("python3", "-I", ASSET_LIBRARY, "iap_pending", API_PLATFORMS.fetch(platform))
  output[/^tips to submit: (\d+)$/, 1].to_i.positive?
end

# precheck as deliver runs it before a submission. In-App Purchases stay out of it: precheck refuses to read them
# with an App Store Connect API key (precheck/runner.rb), the only login CI has.
def submit_with_tips(platform, build)
  passed = precheck(api_key: api_key, app_identifier: APP_ID, platform: platform, default_rule_level: :warn,
                    include_in_app_purchases: false)
  UI.user_error!("precheck found a problem: nothing submitted") if passed == false
  sh("python3", "-I", ASSET_LIBRARY, "iap_submit", API_PLATFORMS.fetch(platform), app_version, build)
end

# Submits for App Review the App Store edition build BUILD_NUMBER of this version, with the listing as it is on App
# Store Connect (the metadata lanes upload it), released as soon as Apple approves it. The number comes from the log of
# the release run that built the App Store edition: never "the latest build", which may be a TestFlight edition one.
# Run only when the user asks for the submission (CLAUDE.md, App Store).
def submit_for_review(platform)
  build = ENV.fetch("BUILD_NUMBER", "").strip
  UI.user_error!("BUILD_NUMBER must be the App Store edition's build number (from its release run's log)") unless build.match?(/\A\d+\z/)
  tips = tips_to_submit?(platform)
  deliver(
    api_key: api_key,
    app_identifier: APP_ID,
    platform: platform,
    app_version: app_version,
    build_number: build,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: true,
    force: true,
    submit_for_review: !tips,
    automatic_release: true,
    run_precheck_before_submit: !tips,
    precheck_include_in_app_purchases: false,
    submission_information: { add_id_info_uses_idfa: false }
  )
  submit_with_tips(platform, build) if tips
end

# A version tag's release (the user's go: CLAUDE.md, App Store): the listing and its screenshots, the App Store edition
# build BUILD_NUMBER uploaded just before, and the submission for App Review, released as soon as Apple approves it.
# A submission of this version still waiting for review is withdrawn first: the newer build replaces it. SUBMIT=false
# (a rehearsal run by hand) does everything but the submission.
def release_for_review(platform, screenshots)
  build = ENV.fetch("BUILD_NUMBER", "").strip
  UI.user_error!("BUILD_NUMBER must be the App Store edition build uploaded by this run") unless build.match?(/\A\d+\z/)
  submit = ENV["SUBMIT"] == "true"
  # Before the withdrawal too: a tip that is not ready stops the release here, so a live submission is never
  # cancelled for a release that would then refuse to submit.
  tips_to_submit?(platform) if submit
  withdraw_from_review(platform) if submit
  # After the withdrawal: tips it took back out of App Review are waiting again.
  tips = submit && tips_to_submit?(platform)
  deliver(
    api_key: api_key,
    app_identifier: APP_ID,
    platform: platform,
    app_version: app_version,
    build_number: build,
    skip_binary_upload: true,
    # Both name fastlane/screenshots/<platform>: File.directory? runs in fastlane/, deliver from the repository root.
    skip_screenshots: !File.directory?("screenshots/#{screenshots}"),
    screenshots_path: "fastlane/screenshots/#{screenshots}",
    overwrite_screenshots: true,
    metadata_path: "fastlane/metadata",
    force: true,
    # Already withdrawn above: deliver would rename a waiting version to the tag's before withdrawing it.
    reject_if_possible: false,
    submit_for_review: submit && !tips,
    automatic_release: true,
    run_precheck_before_submit: submit && !tips,
    precheck_include_in_app_purchases: false,
    submission_information: { add_id_info_uses_idfa: false }
  )
  submit_with_tips(platform, build) if tips
end

# Removes this platform's submission from App Review (waiting, in review, or with unresolved issues) and waits until
# App Store Connect lets the version be edited again: the release replaces it. Done before deliver touches the version.
def withdraw_from_review(platform)
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  api_platform = Spaceship::ConnectAPI::Platform.map(platform)
  submission = app.get_in_progress_review_submission(platform: api_platform)
  return UI.message("No #{platform} submission in review") unless submission
  UI.important("Withdrawing the #{platform} submission (#{submission.state}) from App Review: this release replaces it")
  submission.cancel_submission
  60.times do
    in_progress = app.get_in_progress_review_submission(platform: api_platform)
    canceling = app.get_review_submissions(filter: { platform: api_platform, state: "CANCELING" })
    return UI.success("The #{platform} submission is withdrawn") if in_progress.nil? && canceling.empty?
    sleep(15)
  end
  UI.user_error!("The #{platform} submission is still being withdrawn after 15 minutes: check App Store Connect, then run the release again")
end

before_all do
  setup_ci if ENV["CI"]
end

after_all do |_lane|
  remove_key_file
end

error do |_lane, _exception|
  remove_key_file
end

# Automatic signing makes Xcode create an Apple Development certificate on each new runner to sign the archive
# (the export then uses a cloud-managed distribution certificate). Its private key dies with the runner, and Apple
# caps how many a team may hold: past the cap, signing fails with "Your account has reached the maximum number of
# certificates". The release workflow revokes the runner's own ones when the job ends.
DEVELOPMENT_CERTIFICATE_TYPES = %w[DEVELOPMENT IOS_DEVELOPMENT MAC_APP_DEVELOPMENT].freeze

def serial_key(serial)
  serial.to_s.upcase.sub(/\A0+/, "")
end

# The certificates in this machine's keychains: their DER digests and serial numbers (hexadecimal).
def keychain_certificates
  pems = `security find-certificate -a -p`.scan(/-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----/m)
  certificates = pems.filter_map do |pem|
    OpenSSL::X509::Certificate.new(pem)
  rescue OpenSSL::X509::CertificateError
    nil
  end
  {
    digests: certificates.map { |certificate| OpenSSL::Digest::SHA256.hexdigest(certificate.to_der) }.to_set,
    serials: certificates.map { |certificate| serial_key(certificate.serial.to_s(16)) }.to_set
  }
end

# Whether a certificate of the account is a development certificate held in this machine's keychains.
def runner_development_certificate?(certificate, keychain)
  return false unless DEVELOPMENT_CERTIFICATE_TYPES.include?(certificate.certificate_type)
  content = certificate.certificate_content.to_s
  digest = content.empty? ? nil : OpenSSL::Digest::SHA256.hexdigest(Base64.decode64(content))
  keychain[:digests].include?(digest) || keychain[:serials].include?(serial_key(certificate.serial_number))
end

# What a check of the submitted versions prints: no contact detail, only whether the review contact is complete.
PLATFORMS = { "iOS" => ["IOS", "ios"], "macOS" => ["MAC_OS", "mac"] }.freeze

def report_version(app, name, platform, folder)
  version = app.get_app_store_versions(filter: { platform: platform }, includes: "build,appStoreReviewDetail")
               .find { |candidate| candidate.version_string == app_version }
  return UI.message("#{name} #{app_version}: no such version") unless version

  build = version.build
  UI.message("#{name} #{version.version_string}: #{version.app_store_state}, build #{build ? build.version : 'none selected'}")
  detail = version.app_store_review_detail
  if detail
    contact = [detail.contact_first_name, detail.contact_last_name, detail.contact_email, detail.contact_phone].none? { |value| value.to_s.empty? }
    notes = detail.notes.to_s
    # Neither appears in the notes of a submitted version: the App Store edition has no downloads, and the Mac app no
    # network.server entitlement.
    UI.message("  review contact #{contact ? 'complete' : 'missing'}; notes mention downloads: #{notes.downcase.include?('download')}; " \
               "notes mention network.server: #{notes.include?('network.server')}")
  end
  # Screenshots compared with today's files (fetched from the appstore-screenshots branch by the workflow).
  current = Dir[File.expand_path("screenshots/#{folder}/**/*.png", __dir__)].map { |path| Digest::MD5.file(path).hexdigest }.to_set
  version.get_app_store_version_localizations.each do |localization|
    localization.get_app_screenshot_sets.each do |set|
      shots = set.app_screenshots || []
      same = shots.count { |shot| current.include?(shot.source_file_checksum) }
      UI.message("  #{localization.locale} #{set.screenshot_display_type}: #{shots.count} screenshots, #{same} identical to today's")
      # The address of each one that differs, to look at it (the App Store's own image server).
      shots.reject { |shot| current.include?(shot.source_file_checksum) }.each do |shot|
        template = shot.image_asset.to_h["templateUrl"].to_s
        UI.message("    #{shot.file_name}: #{template.sub('{w}', '1280').sub('{h}', '800').sub('{f}', 'png')}") unless template.empty?
      end
    end
  end
rescue StandardError => e
  UI.error("#{name}: #{e.message}")
end

desc "Print what App Store Connect holds for this version, read only: state, build, review notes, screenshots"
lane :status do
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  PLATFORMS.each { |name, (platform, folder)| report_version(app, name, platform, folder) }
  # Every version's own state: a COMPLETE review submission does not say whether the version was approved or rejected.
  PLATFORMS.each do |name, (platform, _folder)|
    app.get_app_store_versions(filter: { platform: platform }).each do |version|
      UI.message("#{name} version #{version.version_string}: #{version.app_store_state}")
    end
  end
  app.get_review_submissions.each do |submission|
    # The date tells a long wait from a normal one (most reviews take a day or two).
    UI.message("review submission #{submission.platform}: #{submission.state}, submitted #{submission.submitted_date || 'not yet'}")
  end
end

# The App Store's "iPhone and iPad Apps on Apple Silicon Mac" availability is not in the App Store Connect API (4.6: no
# such attribute on apps). With universal purchase, App Store Connect offers it only while no macOS version of the app
# is on the Mac App Store: what is printed is whether one has been, and where the setting is otherwise.
def report_ios_on_mac_app_store(app)
  states = app.get_app_store_versions(filter: { platform: "MAC_OS" }).map(&:app_store_state).uniq
  released = states.include?("READY_FOR_SALE")
  UI.message("Mac App Store: macOS version #{released ? 'on sale (Apple then no longer offers the iOS app on Macs)' : 'not on sale yet'} " \
             "(states: #{states.empty? ? 'none' : states.join(', ')})")
  return if released

  UI.important("The iOS app may be offered on Apple silicon Macs: App Store Connect → Pricing and Availability → " \
               "iPhone and iPad Apps on Apple Silicon Mac → \"Make this app available\" (not readable through the API)")
rescue StandardError => e
  UI.error("Mac App Store availability: #{e.message}")
end

# TestFlight as App Store Connect holds it, read only: groups and their testers, Test Information per language, the
# Beta App Review contact, and each platform's latest builds with their states and What to Test. No contact detail or
# e-mail address is printed (the log of a public repository is public), only whether each is set.
def report_testflight(app)
  mac_testing = begin
    mac_testing_by_group(app)
  rescue StandardError => e
    UI.error("Apple silicon Mac setting of each group (#{e.message})")
    {}
  end
  app.get_beta_groups.each do |group|
    UI.message("group \"#{group.name}\": #{group.is_internal_group ? 'internal' : 'external'}, #{tester_count(group)} testers, " \
               "public link #{group.public_link_enabled ? 'on' : 'off'}, " \
               "iOS builds on Apple silicon Macs #{mac_testing_text(mac_testing.dig(group.id, 1))}")
  end
  report_ios_on_mac_app_store(app)
  app.get_beta_app_localizations.sort_by(&:locale).each do |localization|
    UI.message("Test Information #{localization.locale}: description #{localization.description.to_s.empty? ? 'missing' : 'set'}, " \
               "feedback e-mail #{localization.feedback_email.to_s.empty? ? 'missing' : 'set'}, " \
               "privacy URL #{localization.privacy_policy_url.to_s.empty? ? 'missing' : 'set'}")
  end
  detail = Spaceship::ConnectAPI.get_beta_app_review_detail(filter: { app: app.id }).to_models.first
  fields = %i[contact_first_name contact_last_name contact_phone contact_email]
  UI.message("Beta App Review contact: #{detail && fields.all? { |field| !detail.send(field).to_s.empty? } ? 'set' : 'missing'}, " \
             "notes #{detail&.notes.to_s.empty? ? 'missing' : 'set'}, sign-in required: #{detail&.demo_account_required ? 'yes' : 'no'}")
  external = app.get_beta_groups.reject(&:is_internal_group)
  external_builds = external.flat_map { |group| Spaceship::ConnectAPI.get_builds_for_beta_group(group_id: group.id).all_pages.flat_map(&:to_models) }.map(&:id).to_set
  PLATFORMS.each do |name, (platform, _folder)|
    builds = Spaceship::ConnectAPI.get_builds(
      filter: { app: app.id, "preReleaseVersion.platform" => platform }, sort: "-uploadedDate", limit: 6,
      includes: "preReleaseVersion,buildBetaDetail,betaAppReviewSubmission,betaBuildLocalizations"
    ).to_models
    builds.each do |build|
      detail = build.build_beta_detail
      # The pipeline gives external groups App Store edition builds only; the others are the TestFlight edition (or a
      # tag's App Store edition submitted for App Review). Builds added by hand before it are not told apart.
      edition = external_builds.include?(build.id) ? "in an external group" : "in no external group"
      UI.message("#{name} #{build.app_version} (#{build.version}): #{edition}, #{build.processing_state}, " \
                 "internal #{detail&.internal_build_state || '?'}, external #{detail&.external_build_state || '?'}, " \
                 "beta review #{build.beta_app_review_submission&.beta_review_state || 'not submitted'}" \
                 "#{build.expired ? ', expired' : ''}")
      localizations = (build.beta_build_localizations || []).sort_by(&:locale)
      filled = localizations.reject { |localization| localization.whats_new.to_s.empty? }.map(&:locale)
      UI.message("  What to Test: #{filled.empty? ? 'none' : filled.join(', ')}")
      english = localizations.find { |localization| localization.locale == "en-US" }&.whats_new.to_s
      english.lines.first(3).each { |line| UI.message("    #{line.strip}") }
    end
  end
end

desc "Print TestFlight's state, read only: groups, testers, Apple silicon Macs, Test Information, latest builds, beta review"
lane :testflight_status do
  api_key
  report_testflight(Spaceship::ConnectAPI::App.find(APP_ID))
end

desc "Revoke the development certificates Xcode created on this CI runner (never run it on your own Mac)"
lane :revoke_runner_certificates do
  # GitHub's macOS runners are discarded after the job: a certificate in their keychain is one this job created.
  UI.user_error!("Runs only on a CI runner: on a Mac it would revoke that Mac's certificates") unless ENV["CI"]
  keychain = keychain_certificates
  api_key
  revoked = Spaceship::ConnectAPI::Certificate.all.select { |certificate| runner_development_certificate?(certificate, keychain) }
  revoked.each do |certificate|
    certificate.delete!
    # Neither the name nor the requester: the log of a public repository is public.
    UI.message("Revoked the #{certificate.certificate_type} certificate created on this runner")
  end
  UI.message("No development certificate of this runner to revoke") if revoked.empty?
end

platform :ios do
  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    require_project
    number = next_build_number("ios")
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build/ios-release",
      xcargs: "#{signing_xcargs} #{build_settings_args(number)}"
    )
    upload_build("ios")
    quiet_testers("ios", number)
    report_build_number(number)
    report_what_to_test("ios", number)
  end

  desc "Upload the App Store listing (texts, keywords, URLs, screenshots) without a binary; the age rating is set in App Store Connect"
  lane :metadata do
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "ios",
      app_version: app_version,
      skip_binary_upload: true,
      # Both name fastlane/screenshots/ios: File.directory? runs in fastlane/, deliver from the repository root.
      skip_screenshots: !File.directory?("screenshots/ios"),
      screenshots_path: "fastlane/screenshots/ios",
      overwrite_screenshots: true,
      metadata_path: "fastlane/metadata",
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Submit the App Store edition build BUILD_NUMBER of this version for App Review"
  lane :submit do
    submit_for_review("ios")
  end

  desc "App Store edition build BUILD_NUMBER → external testers, through Beta App Review (never App Review)"
  lane :external_testers do
    distribute_to_external_testers("ios")
  end

  desc "Withdraw the iOS submission from App Review (the user's decision), nothing else"
  lane :withdraw do
    withdraw_from_review("ios")
  end

  desc "Version tag: listing, App Store edition build BUILD_NUMBER and submission for App Review (SUBMIT=true)"
  lane :release do
    release_for_review("ios", "ios")
  end
end

