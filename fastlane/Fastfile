# Committing a Google Play edit cancels the changes in review and sends them again by default, which restarts their
# review (a closed test, the Android TV opt-in, the listing). A push's internal build must not: KEEP_PLAY_REVIEW=true
# commits with changesInReviewBehavior ERROR_IF_IN_REVIEW, and the build waits for a push made after the review.
module KeepPlayReview
  def commit_current_edit!
    ensure_active_edit!
    call_google_api { client.commit_edit(current_package_name, current_edit.id, changes_in_review_behavior: "ERROR_IF_IN_REVIEW") }
    self.current_edit = nil
    self.current_package_name = nil
  end
end

platform :android do
  ANDROID_PACKAGE = "com.markedoe.ondo"

  desc "Upload the signed bundle and the listing to Google Play (track from TRACK, default internal)"
  lane :deploy do
    keep_review = ENV["KEEP_PLAY_REVIEW"] == "true"
    if keep_review
      require "supply"
      Supply::Client.prepend(KeepPlayReview)
    end
    # LISTING=skip sends the build alone: the listing texts and screenshots under review stay as they are.
    skip_listing = ENV.fetch("LISTING", "upload") == "skip"
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      track: ENV.fetch("TRACK", "internal"),
      # Completed sends the release (and the listing) for review at once (managed publishing off); production stays a
      # draft, rolled out in the Play Console.
      release_status: ENV.fetch("TRACK", "internal") == "production" ? "draft" : ENV.fetch("RELEASE_STATUS", "completed"),
      aab: File.expand_path("../android/app/build/outputs/bundle/release/app-release.aab", __dir__),
      # R8's mapping: Android vitals show crashes with the app's own names and lines.
      mapping: File.expand_path("../android/app/build/outputs/mapping/release/mapping.txt", __dir__),
      metadata_path: File.expand_path("metadata-android", __dir__),
      skip_upload_metadata: skip_listing,
      skip_upload_images: skip_listing,
      skip_upload_screenshots: skip_listing || !File.directory?(File.expand_path("metadata-android/en-US/images/phoneScreenshots", __dir__)),
      # Release notes only with the listing: a language the listing does not have yet (a new translation, uploaded by
      # the next tag) would make Google Play refuse the release.
      skip_upload_changelogs: skip_listing,
      # A tag's release must reach review, or the run fails saying why (fastlane would otherwise commit it unsent).
      rescue_changes_not_sent_for_review: ENV.fetch("TRACK", "internal") == "internal"
    )
    # Release Android's next step (closed testing) promotes only a build that Google Play took.
    File.write(ENV["GITHUB_OUTPUT"], "delivered=true\n", mode: "a") if ENV["GITHUB_OUTPUT"]
  rescue FastlaneCore::Interface::FastlaneError => e
    raise unless keep_review && e.message.match?(/review/i)
    # The bundle stays in the discarded edit; the next push's delivery sends one.
    UI.important("Google Play has changes in review: internal paused while Google reviews closed testing; it resumes automatically")
    puts "::warning::Google Play has changes in review: internal paused while Google reviews closed testing; it resumes " \
         "automatically with the next push to main after the review (#{e.message.lines.first&.strip})"
  end

  desc "Release a version of internal testing on a test track (VERSION_CODE, TRACK, RELEASE_STATUS) with its release notes: no new build"
  lane :promote do
    if ENV["KEEP_PLAY_REVIEW"] == "true"
      require "supply"
      Supply::Client.prepend(KeepPlayReview)
    end
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal",
      version_code: Integer(ENV.fetch("VERSION_CODE")),
      track_promote_to: ENV.fetch("TRACK"),
      # Completed sends the release for review at once (managed publishing off); draft leaves it to the Play Console.
      track_promote_release_status: ENV.fetch("RELEASE_STATUS", "completed"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      # The release notes of metadata-android/<language>/changelogs/default.txt; the listing stays as it is.
      metadata_path: File.expand_path("metadata-android", __dir__),
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the listing's images alone (LANGUAGES, default all): no build, no track, no text, no release notes"
  lane :listing_images do
    # A commit never cancels and restarts a review in progress: while Google reviews something, Google Play refuses
    # it and nothing changes; otherwise the new images go to Google's review of the listing.
    require "supply"
    require "tmpdir"
    Supply::Client.prepend(KeepPlayReview)
    source = File.expand_path("metadata-android", __dir__)
    languages = ENV.fetch("LANGUAGES", "").split
    languages = Dir.children(source).select { |name| File.directory?(File.join(source, name)) }.sort if languages.empty?
    Dir.mktmpdir do |folder|
      # Only the images of the languages asked for: supply reads no text there.
      languages.each do |language|
        images = File.join(source, language, "images")
        UI.user_error!("#{language}: no images in #{images}") unless File.directory?(images)
        FileUtils.mkdir_p(File.join(folder, language))
        FileUtils.cp_r(images, File.join(folder, language))
      end
      # supply reads a release of a track to attach release notes to (none are sent): internal testing's newest.
      version_code = google_play_track_version_codes(package_name: ANDROID_PACKAGE, track: "internal",
                                                     json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON")).max
      upload_to_play_store(
        package_name: ANDROID_PACKAGE,
        json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
        track: "internal",
        version_code: version_code,
        skip_upload_aab: true,
        skip_upload_apk: true,
        metadata_path: folder,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: false,
        skip_upload_screenshots: false,
        # An image already on Google Play (same SHA-256, same place) is not sent again.
        sync_image_upload: true
      )
    end
    UI.success("Listing images sent for #{languages.join(', ')}")
  rescue FastlaneCore::Interface::FastlaneError => e
    raise unless e.message.match?(/review/i)
    UI.important("Google Play has changes in review: the listing images stay as they are; run this again after the review")
    puts "::error::Google Play has changes in review: nothing was changed (the review goes on); run this again after it (#{e.message.lines.first&.strip})"
    raise
  end

  desc "Upload only the Google Play listing (texts and images)"
  lane :metadata do
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      metadata_path: File.expand_path("metadata-android", __dir__)
    )
  end
end
