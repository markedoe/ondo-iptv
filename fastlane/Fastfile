# Delivery lanes for Ondo: App Store (iOS + macOS share one bundle ID: universal purchase), run by
# .github/workflows/release.yml, and Google Play, run by .github/workflows/release-android.yml.
#
# Required environment (GitHub secrets in CI, see docs/RELEASE.md and docs/RELEASE-ANDROID.md):
#   ios / mac lanes: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (the App Store Connect API key: a Team key with the
#   Admin role, which cloud-managed signing needs; the .p8 file content as is, or base64 encoded), and for the
#   beta lanes DEVELOPMENT_TEAM (Apple team ID).
#   android lanes: PLAY_SERVICE_ACCOUNT_JSON (Google Play service account key); deploy also reads TRACK
#   (default internal) and RELEASE_STATUS (default completed, internal track only).
# Apple signing is automatic: Xcode uses the API key to create/download cloud-managed certificates and profiles.
#
# Paths: Ruby code and `sh` run in fastlane/, actions (deliver, gym…) from the repository root.

require "base64"
require "digest"
require "openssl"
require "set"
require "tmpdir"

default_platform(:ios)

APP_ID = "com.markedoe.ondo"
PROJECT = "Ondo.xcodeproj"
SCHEME = "Ondo"

# The PEM text of the key, whether the secret holds the file content or its base64.
def key_pem
  value = ENV.fetch("ASC_KEY_P8").strip
  value.include?("BEGIN PRIVATE KEY") ? "#{value}\n" : Base64.decode64(value)
end

def api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: key_pem,
    is_key_content_base64: false,
    in_house: false
  )
end

# The key as a file, for xcodebuild's -authenticationKeyPath: outside the checkout (the runner's temporary
# folder in CI), readable by this user only, deleted when the lane ends (after_all / error below).
KEY_FILE = File.join(ENV["RUNNER_TEMP"] || Dir.tmpdir, "ondo_asc_key.p8")

def key_file
  File.delete(KEY_FILE) if File.exist?(KEY_FILE)
  File.write(KEY_FILE, key_pem, perm: 0o600)
  KEY_FILE
end

def remove_key_file
  File.delete(KEY_FILE) if File.exist?(KEY_FILE)
end

# Lets xcodebuild create and fetch cloud-managed certificates and profiles. gym passes xcargs to both
# the archive and the export, so these flags must not be repeated in export_xcargs (xcodebuild rejects them twice).
def authentication_xcargs
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{key_file}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  ].join(" ")
end

def signing_xcargs
  "#{authentication_xcargs} DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')} CODE_SIGN_STYLE=Automatic"
end

# The release workflow generates the project with XcodeGen in a step of its own, without the signing secrets; on a
# Mac, run `xcodegen generate` first.
def require_project
  return if File.directory?(File.expand_path("../#{PROJECT}", __dir__))
  UI.user_error!("#{PROJECT} is missing: run `xcodegen generate` at the repository root first")
end

# Build number: the platform's latest upload on App Store Connect + 1 (1 for the first one), so a re-run or
# an upload made by hand is never reused. An API error (key, missing app) stops the lane here, before a long
# build that App Store Connect would refuse.
def next_build_number(platform)
  latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, platform: platform, initial_build_number: 0)
  latest.to_i + 1
end

# The version comes from the tag (v1.2.3 → 1.2.3); without one (a manual run on a branch, even one whose name starts
# with v), project.yml's MARKETING_VERSION is kept. A v tag that is not a version stops the lane: its builds would
# otherwise go to project.yml's version.
def marketing_version
  return nil unless ENV["GITHUB_REF_TYPE"] == "tag"
  tag = ENV["GITHUB_REF_NAME"].to_s
  return nil unless tag.start_with?("v")
  UI.user_error!("Tag #{tag} is not a version (v1.2 or v1.2.3)") unless tag.match?(/\Av\d+(\.\d+){1,2}\z/)
  tag.delete_prefix("v")
end

# The App Store version the listing goes to, the same as the builds': the tag's, otherwise project.yml's.
def app_version
  marketing_version || File.read(File.expand_path("../project.yml", __dir__), encoding: "UTF-8")[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
end

def build_settings_args(build_number)
  args = ["CURRENT_PROJECT_VERSION=#{build_number}"]
  args << "MARKETING_VERSION=#{marketing_version}" if marketing_version
  # The TestFlight edition has downloads (FeatureFlags.downloads); the App Store edition, the one submitted, has not.
  args << "'SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) TESTFLIGHT_DOWNLOADS'" if testflight_edition?
  args.join(" ")
end

# EDITION from the release workflow: "testflight" for testers, anything else builds the App Store edition.
def testflight_edition?
  ENV["EDITION"] == "testflight"
end

# A version tag's release waits until App Store Connect has processed the build (minutes to half an hour): only a
# processed build can be selected for review. Pushes to main do not wait.
def wait_for_processing?
  ENV["WAIT_FOR_PROCESSING"] == "true"
end

# Uploads to TestFlight, waiting for the processing when the build is to be submitted (no tester group is notified).
def upload_build(platform)
  upload_to_testflight(
    api_key: api_key,
    app_platform: platform,
    skip_waiting_for_build_processing: !wait_for_processing?,
    skip_submission: true,
    wait_processing_timeout_duration: 5400
  )
end

# TestFlight e-mails every tester for each new build unless the build's "notify testers" is off: Ondo's uploads
# turn it off (testers find each build in the TestFlight app). Set while App Store Connect still processes the
# build, before it is offered. Best effort: a failure here leaves the upload as it is.
def quiet_testers(platform, number)
  api_key # also authorizes Spaceship::ConnectAPI
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  detail = nil
  40.times do
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, build_number: number.to_s, platform: Spaceship::ConnectAPI::Platform.map(platform)).first
    detail = build&.build_beta_detail
    break if detail
    sleep 15
  end
  if detail
    Spaceship::ConnectAPI.patch_build_beta_details(build_beta_details_id: detail.id, attributes: { autoNotifyEnabled: false })
    UI.message("Build #{number}: testers are not e-mailed")
  else
    UI.important("Build #{number} not found on App Store Connect yet: testers may be e-mailed for it")
  end
rescue StandardError => e
  UI.important("Build #{number}: could not turn off the testers' e-mail (#{e.message})")
end

# The build number of this upload for the steps after it (the submission in release.yml).
def report_build_number(number)
  File.write(ENV["GITHUB_OUTPUT"], "build=#{number}\n", mode: "a") if ENV["GITHUB_OUTPUT"]
  UI.message("Build number #{number}")
end

# Submits for App Review the App Store edition build BUILD_NUMBER of this version, with the listing as it is on App
# Store Connect (the metadata lanes upload it), released as soon as Apple approves it. The number comes from the log of
# the release run that built the App Store edition: never "the latest build", which may be a TestFlight edition one.
# Run only when the user asks for the submission (CLAUDE.md, App Store).
def submit_for_review(platform)
  build = ENV.fetch("BUILD_NUMBER", "").strip
  UI.user_error!("BUILD_NUMBER must be the App Store edition's build number (from its release run's log)") unless build.match?(/\A\d+\z/)
  deliver(
    api_key: api_key,
    app_identifier: APP_ID,
    platform: platform,
    app_version: app_version,
    build_number: build,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_screenshots: true,
    force: true,
    submit_for_review: true,
    automatic_release: true,
    run_precheck_before_submit: true,
    precheck_include_in_app_purchases: false,
    submission_information: { add_id_info_uses_idfa: false }
  )
end

# A version tag's release (the user's go: CLAUDE.md, App Store): the listing and its screenshots, the App Store edition
# build BUILD_NUMBER uploaded just before, and the submission for App Review, released as soon as Apple approves it.
# A submission of this version still waiting for review is withdrawn first: the newer build replaces it. SUBMIT=false
# (a rehearsal run by hand) does everything but the submission.
def release_for_review(platform, screenshots)
  build = ENV.fetch("BUILD_NUMBER", "").strip
  UI.user_error!("BUILD_NUMBER must be the App Store edition build uploaded by this run") unless build.match?(/\A\d+\z/)
  submit = ENV["SUBMIT"] == "true"
  withdraw_from_review(platform) if submit
  deliver(
    api_key: api_key,
    app_identifier: APP_ID,
    platform: platform,
    app_version: app_version,
    build_number: build,
    skip_binary_upload: true,
    # Both name fastlane/screenshots/<platform>: File.directory? runs in fastlane/, deliver from the repository root.
    skip_screenshots: !File.directory?("screenshots/#{screenshots}"),
    screenshots_path: "fastlane/screenshots/#{screenshots}",
    overwrite_screenshots: true,
    metadata_path: "fastlane/metadata",
    force: true,
    # Already withdrawn above: deliver would rename a waiting version to the tag's before withdrawing it.
    reject_if_possible: false,
    submit_for_review: submit,
    automatic_release: true,
    run_precheck_before_submit: submit,
    precheck_include_in_app_purchases: false,
    submission_information: { add_id_info_uses_idfa: false }
  )
end

# Removes this platform's submission from App Review (waiting, in review, or with unresolved issues) and waits until
# App Store Connect lets the version be edited again: the release replaces it. Done before deliver touches the version.
def withdraw_from_review(platform)
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  api_platform = Spaceship::ConnectAPI::Platform.map(platform)
  submission = app.get_in_progress_review_submission(platform: api_platform)
  return UI.message("No #{platform} submission in review") unless submission
  UI.important("Withdrawing the #{platform} submission (#{submission.state}) from App Review: this release replaces it")
  submission.cancel_submission
  60.times do
    in_progress = app.get_in_progress_review_submission(platform: api_platform)
    canceling = app.get_review_submissions(filter: { platform: api_platform, state: "CANCELING" })
    return UI.success("The #{platform} submission is withdrawn") if in_progress.nil? && canceling.empty?
    sleep(15)
  end
  UI.user_error!("The #{platform} submission is still being withdrawn after 15 minutes: check App Store Connect, then run the release again")
end

before_all do
  setup_ci if ENV["CI"]
end

after_all do |_lane|
  remove_key_file
end

error do |_lane, _exception|
  remove_key_file
end

# Automatic signing makes Xcode create an Apple Development certificate on each new runner to sign the archive
# (the export then uses a cloud-managed distribution certificate). Its private key dies with the runner, and Apple
# caps how many a team may hold: past the cap, signing fails with "Your account has reached the maximum number of
# certificates". The release workflow revokes the runner's own ones when the job ends.
DEVELOPMENT_CERTIFICATE_TYPES = %w[DEVELOPMENT IOS_DEVELOPMENT MAC_APP_DEVELOPMENT].freeze

def serial_key(serial)
  serial.to_s.upcase.sub(/\A0+/, "")
end

# The certificates in this machine's keychains: their DER digests and serial numbers (hexadecimal).
def keychain_certificates
  pems = `security find-certificate -a -p`.scan(/-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----/m)
  certificates = pems.filter_map do |pem|
    OpenSSL::X509::Certificate.new(pem)
  rescue OpenSSL::X509::CertificateError
    nil
  end
  {
    digests: certificates.map { |certificate| OpenSSL::Digest::SHA256.hexdigest(certificate.to_der) }.to_set,
    serials: certificates.map { |certificate| serial_key(certificate.serial.to_s(16)) }.to_set
  }
end

# Whether a certificate of the account is a development certificate held in this machine's keychains.
def runner_development_certificate?(certificate, keychain)
  return false unless DEVELOPMENT_CERTIFICATE_TYPES.include?(certificate.certificate_type)
  content = certificate.certificate_content.to_s
  digest = content.empty? ? nil : OpenSSL::Digest::SHA256.hexdigest(Base64.decode64(content))
  keychain[:digests].include?(digest) || keychain[:serials].include?(serial_key(certificate.serial_number))
end

# What a check of the submitted versions prints: no contact detail, only whether the review contact is complete.
PLATFORMS = { "iOS" => ["IOS", "ios"], "macOS" => ["MAC_OS", "mac"] }.freeze

def report_version(app, name, platform, folder)
  version = app.get_app_store_versions(filter: { platform: platform }, includes: "build,appStoreReviewDetail")
               .find { |candidate| candidate.version_string == app_version }
  return UI.message("#{name} #{app_version}: no such version") unless version

  build = version.build
  UI.message("#{name} #{version.version_string}: #{version.app_store_state}, build #{build ? build.version : 'none selected'}")
  detail = version.app_store_review_detail
  if detail
    contact = [detail.contact_first_name, detail.contact_last_name, detail.contact_email, detail.contact_phone].none? { |value| value.to_s.empty? }
    notes = detail.notes.to_s
    # Neither appears in the notes of a submitted version: the App Store edition has no downloads, and the Mac app no
    # network.server entitlement.
    UI.message("  review contact #{contact ? 'complete' : 'missing'}; notes mention downloads: #{notes.downcase.include?('download')}; " \
               "notes mention network.server: #{notes.include?('network.server')}")
  end
  # Screenshots compared with today's files (fetched from the appstore-screenshots branch by the workflow).
  current = Dir[File.expand_path("screenshots/#{folder}/**/*.png", __dir__)].map { |path| Digest::MD5.file(path).hexdigest }.to_set
  version.get_app_store_version_localizations.each do |localization|
    localization.get_app_screenshot_sets.each do |set|
      shots = set.app_screenshots || []
      same = shots.count { |shot| current.include?(shot.source_file_checksum) }
      UI.message("  #{localization.locale} #{set.screenshot_display_type}: #{shots.count} screenshots, #{same} identical to today's")
      # The address of each one that differs, to look at it (the App Store's own image server).
      shots.reject { |shot| current.include?(shot.source_file_checksum) }.each do |shot|
        template = shot.image_asset.to_h["templateUrl"].to_s
        UI.message("    #{shot.file_name}: #{template.sub('{w}', '1280').sub('{h}', '800').sub('{f}', 'png')}") unless template.empty?
      end
    end
  end
rescue StandardError => e
  UI.error("#{name}: #{e.message}")
end

desc "Print what App Store Connect holds for this version, read only: state, build, review notes, screenshots"
lane :status do
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  PLATFORMS.each { |name, (platform, folder)| report_version(app, name, platform, folder) }
  app.get_review_submissions.each do |submission|
    # The date tells a long wait from a normal one (most reviews take a day or two).
    UI.message("review submission #{submission.platform}: #{submission.state}, submitted #{submission.submitted_date || 'not yet'}")
  end
end

desc "Revoke the development certificates Xcode created on this CI runner (never run it on your own Mac)"
lane :revoke_runner_certificates do
  # GitHub's macOS runners are discarded after the job: a certificate in their keychain is one this job created.
  UI.user_error!("Runs only on a CI runner: on a Mac it would revoke that Mac's certificates") unless ENV["CI"]
  keychain = keychain_certificates
  api_key
  revoked = Spaceship::ConnectAPI::Certificate.all.select { |certificate| runner_development_certificate?(certificate, keychain) }
  revoked.each do |certificate|
    certificate.delete!
    # Neither the name nor the requester: the log of a public repository is public.
    UI.message("Revoked the #{certificate.certificate_type} certificate created on this runner")
  end
  UI.message("No development certificate of this runner to revoke") if revoked.empty?
end

platform :ios do
  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    require_project
    number = next_build_number("ios")
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build/ios-release",
      xcargs: "#{signing_xcargs} #{build_settings_args(number)}"
    )
    upload_build("ios")
    quiet_testers("ios", number)
    report_build_number(number)
  end

  desc "Upload the App Store listing (texts, keywords, URLs, screenshots) without a binary; the age rating is set in App Store Connect"
  lane :metadata do
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "ios",
      app_version: app_version,
      skip_binary_upload: true,
      # Both name fastlane/screenshots/ios: File.directory? runs in fastlane/, deliver from the repository root.
      skip_screenshots: !File.directory?("screenshots/ios"),
      screenshots_path: "fastlane/screenshots/ios",
      overwrite_screenshots: true,
      metadata_path: "fastlane/metadata",
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Submit the App Store edition build BUILD_NUMBER of this version for App Review"
  lane :submit do
    submit_for_review("ios")
  end

  desc "Version tag: listing, App Store edition build BUILD_NUMBER and submission for App Review (SUBMIT=true)"
  lane :release do
    release_for_review("ios", "ios")
  end
end

platform :mac do
  desc "Upload the Mac App Store listing (texts, URLs, screenshots) without a binary"
  lane :metadata do
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      platform: "osx",
      app_version: app_version,
      skip_binary_upload: true,
      # Both name fastlane/screenshots/mac (see the iOS lane).
      skip_screenshots: !File.directory?("screenshots/mac"),
      screenshots_path: "fastlane/screenshots/mac",
      overwrite_screenshots: true,
      metadata_path: "fastlane/metadata",
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Submit the App Store edition build BUILD_NUMBER of this version for App Review"
  lane :submit do
    submit_for_review("osx")
  end

  desc "Version tag: listing, App Store edition build BUILD_NUMBER and submission for App Review (SUBMIT=true)"
  lane :release do
    release_for_review("osx", "mac")
  end

  desc "Build the macOS app and upload it to TestFlight / App Store Connect"
  lane :beta do
    require_project
    number = next_build_number("osx")
    build_mac_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=macOS",
      # One multiplatform target: gym only packages a .pkg (not an .ipa) when the SDK says macOS.
      sdk: "macosx",
      # The export signs automatically (-allowProvisioningUpdates in xcargs), the .pkg too: no installer certificate
      # is looked up in the keychain. Kept explicit since the release that shipped build 6 used it.
      export_method: "app-store",
      installer_cert_name: nil,
      output_directory: "build/mac-release",
      xcargs: "#{signing_xcargs} #{build_settings_args(number)}"
    )
    upload_build("osx")
    quiet_testers("osx", number)
    report_build_number(number)
  end
end

# Committing a Google Play edit cancels the changes in review and sends them again by default, which restarts their
# review (a closed test, the Android TV opt-in, the listing). A push's internal build must not: KEEP_PLAY_REVIEW=true
# commits with changesInReviewBehavior ERROR_IF_IN_REVIEW, and the build waits for a push made after the review.
module KeepPlayReview
  def commit_current_edit!
    ensure_active_edit!
    call_google_api { client.commit_edit(current_package_name, current_edit.id, changes_in_review_behavior: "ERROR_IF_IN_REVIEW") }
    self.current_edit = nil
    self.current_package_name = nil
  end
end

platform :android do
  ANDROID_PACKAGE = "com.markedoe.ondo"

  desc "Upload the signed bundle and the listing to Google Play (track from TRACK, default internal)"
  lane :deploy do
    keep_review = ENV["KEEP_PLAY_REVIEW"] == "true"
    if keep_review
      require "supply"
      Supply::Client.prepend(KeepPlayReview)
    end
    # LISTING=skip sends the build alone: the listing texts and screenshots under review stay as they are.
    skip_listing = ENV.fetch("LISTING", "upload") == "skip"
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      track: ENV.fetch("TRACK", "internal"),
      # Completed sends the release (and the listing) for review at once (managed publishing off); production stays a
      # draft, rolled out in the Play Console.
      release_status: ENV.fetch("TRACK", "internal") == "production" ? "draft" : ENV.fetch("RELEASE_STATUS", "completed"),
      aab: File.expand_path("../android/app/build/outputs/bundle/release/app-release.aab", __dir__),
      # R8's mapping: Android vitals show crashes with the app's own names and lines.
      mapping: File.expand_path("../android/app/build/outputs/mapping/release/mapping.txt", __dir__),
      metadata_path: File.expand_path("metadata-android", __dir__),
      skip_upload_metadata: skip_listing,
      skip_upload_images: skip_listing,
      skip_upload_screenshots: skip_listing || !File.directory?(File.expand_path("metadata-android/en-US/images/phoneScreenshots", __dir__)),
      skip_upload_changelogs: false,
      # A tag's release must reach review, or the run fails saying why (fastlane would otherwise commit it unsent).
      rescue_changes_not_sent_for_review: ENV.fetch("TRACK", "internal") == "internal"
    )
  rescue FastlaneCore::Interface::FastlaneError => e
    raise unless keep_review && e.message.match?(/review/i)
    # The bundle stays in the discarded edit; the next push's delivery sends one.
    UI.important("Google Play has changes in review: this internal build was not sent, so as not to restart that review")
    puts "::warning::Google Play has changes in review: this internal build was not sent (#{e.message.lines.first&.strip})"
  end

  desc "Promote a version of internal testing to a test track (VERSION_CODE, TRACK), as a draft: no new build"
  lane :promote do
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      track: "internal",
      version_code: Integer(ENV.fetch("VERSION_CODE")),
      track_promote_to: ENV.fetch("TRACK"),
      # Reviewed and rolled out in the Play Console, like any release outside internal testing.
      track_promote_release_status: "draft",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload only the Google Play listing (texts and images)"
  lane :metadata do
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      metadata_path: File.expand_path("metadata-android", __dir__)
    )
  end
end
